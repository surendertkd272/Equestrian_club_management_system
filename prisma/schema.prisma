// Equiwings Central Admin Panel — data model
// Multi-tenant: every centre-scoped row carries centre_id.
// Dev: SQLite. Prod: switch provider to "postgresql" and run prisma migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL — pooled connection for the running app. Supabase's
  // PgBouncer endpoint (port 6543) prevents the serverless runtime from
  // exhausting Postgres connections under load. Append
  // `?pgbouncer=true&connection_limit=1` for safe behaviour.
  url       = env("DATABASE_URL")
  // DIRECT_URL — direct port-5432 connection. Prisma uses this for
  // migrations + introspection only; the app never opens these sockets
  // at runtime. Required because pgbouncer in transaction mode can't
  // run the queries Prisma migrations need.
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// AUTH / TENANCY
// ──────────────────────────────────────────────────────────────────────────

model Organisation {
  id        String   @id @default(cuid())
  slug      String   @unique // URL identifier — e.g. "equiwings"
  name      String
  logoUrl   String?

  // Lifecycle / billing (plan drives the feature set via lib/plans.ts)
  status             String    @default("active") // active | trial | past_due | suspended
  // When the org most recently entered past_due. Dunning reminders and the
  // 7-day suspend countdown anchor on THIS, not updatedAt — updatedAt is bumped
  // by any unrelated org write (settings change, logo upload…), which used to
  // silently reset the overdue clock and skip dunning / delay suspension.
  // Set on entering past_due (only if not already past_due, so the clock isn't
  // reset by repeated webhooks); cleared (null) on returning to active/suspended.
  pastDueSince       DateTime?
  plan               String    @default("starter") // starter | pro | enterprise (lib/plans.ts)
  contactName        String?
  billingEmail       String?
  phone              String?
  trialEndsAt        DateTime?
  onboardedAt        DateTime  @default(now())
  // Offboarding lifecycle. When the owner schedules a tenant for
  // decommission, offboardingScheduledAt + offboardingNotes are stamped
  // and status moves to "offboarding". The sweep at lib/sweeps.ts hard-
  // deletes everything after the grace period.
  offboardingScheduledAt DateTime?
  offboardingNotes       String?
  offboardingScrubbedAt  DateTime?
  // Stripe — columns staged for V1.1 wire-up; status is hand-flippable until then.
  stripeCustomerId   String?
  subscriptionStatus String?
  currentPeriodEnd   DateTime?
  // Razorpay Subscriptions — used in India where Stripe card recurring
  // is unreliable. One subscription per org; status mirrors Razorpay
  // states (created/authenticated/active/halted/cancelled).
  razorpaySubscriptionId String?
  razorpaySubscriptionStatus String?

  // Custom domain — tenant points a CNAME (e.g. app.royalriders.com) at our
  // host. SSL + DNS verification happen at the hosting layer; this column is
  // metadata so the owner portal can record + display the alias. Null = the
  // tenant uses the platform default host (with optional /t/<slug>/ prefix).
  customDomain          String?   @unique
  customDomainVerifiedAt DateTime?

  settings  String? // JSON-as-text for SQLite portability
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant's own billing identity — captured at onboarding so we can
  // print compliant invoices on the SaaS subscription. State is the
  // Indian state name (used to compute CGST+SGST vs IGST).
  billingGstin   String?
  billingState   String?
  billingAddress String?

  centres  Centre[]
  features OrgFeature[]
  saasInvoices SaasInvoice[]
  hqExpenses   HqExpense[]
  legalTexts   LegalText[]
  // HQ users (typically SUPER_ADMIN) whose centreId is null — the org link
  // is recorded here directly. Centre-scoped users find their org via the
  // centre table instead.
  hqUsers  User[]       @relation("HqUsers")
  payrollConfig PayrollConfig?
}

// Editable legal text — T&C, Indemnity Bond, Rules & Regulations. Each
// "kind" has multiple versions over time; the active version is the one
// with the latest publishedAt for that kind. Rider rows snapshot the
// version they accepted, so HQ can publish a new T&C without retroactively
// breaking the audit trail.
//
// Org-scoped so a future multi-tenant deployment can let each tenant
// override the platform default. Today we only have one tenant so all
// rows share the same orgId.
model LegalText {
  id          String   @id @default(cuid())
  orgId       String
  // terms | indemnity | rules
  kind        String
  // Free-form version label set by the admin who publishes ("v1", "2026-05", "draft").
  version     String
  // Markdown / plain text content shown to the user. Stored as text so a
  // future admin editor can serialise rich content here.
  content     String
  publishedAt DateTime @default(now())
  publishedByUserId String

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, kind, version])
  @@index([orgId, kind, publishedAt])
}

// Daily-checklist module. The coach / stable manager submits a daily
// report; the items on that report come from a ChecklistTemplate that
// super_admin / admin curates per centre.
//
// One template per centre per "scope" (general vs per-horse). Admin can
// edit items at any time; we snapshot the item *label* into each
// ChecklistSubmissionItem on submit so historic submissions survive
// renames + soft-deletes. active=false on an item hides it from new
// submissions but keeps it on older ones.

model ChecklistTemplate {
  id          String   @id @default(cuid())
  centreId    String
  scope       String   // general | per_horse
  name        String   // "Daily ops" | "Per-horse daily report"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  centre      Centre                @relation(fields: [centreId], references: [id], onDelete: Cascade)
  items       ChecklistItem[]
  submissions ChecklistSubmission[]

  @@unique([centreId, scope])
  @@index([centreId])
}

model ChecklistItem {
  id          String   @id @default(cuid())
  templateId  String
  label       String
  orderIndex  Int      @default(0)
  section     String?  // optional grouping header ("Horse Health & Welfare")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template ChecklistTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  results  ChecklistSubmissionItem[]

  @@index([templateId, orderIndex])
}

model ChecklistSubmission {
  id                String   @id @default(cuid())
  templateId        String
  centreId          String
  submittedByUserId String
  horseId           String?  // set for per_horse submissions
  submittedAt       DateTime @default(now())
  generalNotes      String?
  shift             String?  // morning | evening (daily coach checklist)
  // Coach's truthful-submission declaration (the PDF's certify line). The
  // submitter is already recorded via submittedByUserId — this is the explicit
  // tick that the checks were really done.
  declarationAgreed Boolean  @default(false)
  // Stable-manager countersign (the PDF's manager signature line).
  reviewedByUserId  String?
  reviewedAt        DateTime?

  template ChecklistTemplate          @relation(fields: [templateId], references: [id])
  centre   Centre                     @relation(fields: [centreId], references: [id])
  horse    Horse?                     @relation(fields: [horseId], references: [id], onDelete: SetNull)
  items    ChecklistSubmissionItem[]

  @@index([centreId, submittedAt])
  @@index([templateId, submittedAt])
  @@index([horseId])
}

model ChecklistSubmissionItem {
  id              String   @id @default(cuid())
  submissionId    String
  itemId          String
  itemLabel       String   // snapshotted at submit time
  itemSection     String?
  status          String   // done | not_done | na
  remarks         String?

  submission ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  item       ChecklistItem       @relation(fields: [itemId], references: [id])

  @@index([submissionId])
  @@index([itemId])
}

// Per-horse deworming schedule. Separate from VaccinationSchedule because
// the cadence (every 8-12 weeks rotating drugs) and the drug choice are
// different. Tracked alongside vaccines in the Medical Records tab.
model DewormingSchedule {
  id            String   @id @default(cuid())
  horseId       String
  product       String   // "Ivermectin Paste" | "Praziquantel" etc.
  scheduledAt   DateTime
  givenAt       DateTime?
  givenByUserId String?
  nextDueAt     DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([horseId, scheduledAt])
}

// Monthly skill catalog + per-rider per-month evaluations. Distinct from
// the always-on RiderSkillStatus: this is a coach's monthly snapshot
// against an admin-curated skill list specific to that month.
model MonthlySkillCatalog {
  id         String   @id @default(cuid())
  centreId   String
  yearMonth  String   // "2026-05"
  skillLabel String
  orderIndex Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  centre Centre             @relation(fields: [centreId], references: [id], onDelete: Cascade)
  marks  MonthlySkillMark[]

  @@unique([centreId, yearMonth, skillLabel])
  @@index([centreId, yearMonth])
}

model MonthlySkillMark {
  id             String   @id @default(cuid())
  catalogId      String
  riderId        String
  rating         Int      @default(0) // 0 not yet · 1 needs work · 2 confident · 3 mastered
  coachNotes     String?
  markedByUserId String
  markedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  catalog MonthlySkillCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  rider   Rider               @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([catalogId, riderId])
  @@index([riderId, markedAt])
}

// Employee salary advance — admin records a cash advance to a staff
// member; the accountant then deducts it from the next payroll run.
// State machine: outstanding → repaid (fully deducted) | written_off (HR call).
//
// Today there's no Payroll model in Equiwings (salaries are paid out-of-band).
// This table is the ledger so the accountant has a single source of truth
// for "what does this employee still owe back". When a Payroll module
// lands we'll wire deductions to AdvanceRepayment rows.
model EmployeeAdvance {
  id              String   @id @default(cuid())
  userId          String
  centreId        String
  amount          Float    // INR
  reason          String   // "School fees", "medical", etc.
  givenAt         DateTime @default(now())
  givenByUserId   String
  // Status flips to repaid when sum(repayments.amount) >= amount, or
  // written_off if HR cancels the balance.
  status          String   @default("outstanding") // outstanding | partially_repaid | repaid | written_off
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User    @relation("EmployeeAdvanceUser", fields: [userId], references: [id])
  centre      Centre  @relation(fields: [centreId], references: [id])
  repayments  AdvanceRepayment[]

  @@index([userId, status])
  @@index([centreId, status])
}

// Each row is a deduction from one advance — typically minted by the
// accountant when running payroll. Sum across repayments must not exceed
// EmployeeAdvance.amount (enforced in the API, not the schema).
model AdvanceRepayment {
  id            String   @id @default(cuid())
  advanceId     String
  amount        Float
  deductedAt    DateTime @default(now())
  recordedByUserId String
  notes         String?

  advance EmployeeAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@index([advanceId, deductedAt])
}

// Employee separation — Admin / Super Admin sends a "you have been asked
// to leave / resign" notice to a user. The user receives the row, writes
// their reason for resignation, and submits — at which point User.status
// flips to resigned or terminated.
//
// Two-step so the audit trail captures both sides: the admin's reason
// for initiating (kind = "termination" or "resignation_request"), and
// the user's own reason. Each row is ONE event; if the admin issues
// multiple notices, each gets its own row.
model SeparationNotice {
  id              String   @id @default(cuid())
  userId          String   // the staff member separating
  centreId        String?  // null for HQ-tier users
  // termination = company-initiated; resignation_request = the user is
  // resigning and the admin is issuing the form for them to fill.
  kind            String   // termination | resignation_request
  // What the admin wrote in the notice (reason / context).
  noticeText      String
  issuedByUserId  String
  issuedAt        DateTime @default(now())
  // User's response — what they write back. Blank until they submit.
  responseText    String?
  respondedAt     DateTime?
  // Outcome — once the user submits, status flips. "withdrawn" is for
  // when the admin rescinds the notice before the user responds.
  status          String   @default("pending") // pending | submitted | withdrawn
  // Effective date — when the separation takes effect (after notice period).
  // The admin sets this on issue; if blank, defaults to issuedAt + 30 days.
  effectiveAt     DateTime?

  user   User    @relation("SeparationUser", fields: [userId], references: [id])
  centre Centre? @relation(fields: [centreId], references: [id])

  @@index([userId, issuedAt])
  @@index([status])
}

// Per-organisation feature toggle. Source of truth: if a row says enabled=true,
// the feature shows up regardless of plan. Plan changes rewrite this table;
// Enterprise can deviate (à-la-carte overrides), Starter/Pro can't.
model OrgFeature {
  orgId      String
  featureKey String // see lib/features.ts
  enabled    Boolean  @default(false)
  enabledAt  DateTime @default(now())
  enabledBy  String? // PlatformUser.id of the toggler

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, featureKey])
  @@index([featureKey])
}

// Per-plan pricing + Razorpay plan IDs. One row per commercial tier
// (starter / pro / enterprise) — keyed by plan name so the row id stays
// stable across renames. The public /pricing page + the owner portal
// both read from here. Razorpay plan IDs stored here override the env
// fallback in lib/razorpay.ts → bumping prices no longer requires a
// redeploy, only a Razorpay plan create + a paste into this table.
//
// The tagline + highlight columns power the marketing display; isVisible
// lets the owner hide a tier temporarily without losing the config.
model PlatformPricing {
  key                   String   @id // "starter" | "pro" | "enterprise"
  label                 String   @default("")
  tagline               String   @default("")
  // Display ₹ amounts. annualInrPerMonth is the price shown when "billed
  // annually" — typical ~15-20% discount vs monthlyInr.
  monthlyInr            Int      @default(0)
  annualInrPerMonth     Int      @default(0)
  // Marketing flags.
  highlight             Boolean  @default(false)
  isVisible             Boolean  @default(true)
  // Razorpay plan IDs — owner sets after creating the plans in their
  // dashboard. Empty string falls back to the env var of the same name.
  razorpayPlanIdMonthly String?
  razorpayPlanIdAnnual  String?
  sortOrder             Int      @default(0)
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

// Single-row config table for the SaaS provider's own billing identity.
// Stores the legal entity name, GSTIN, HSN/SAC, registered address,
// invoice prefix, and currency — used when we issue invoices to tenants
// for the SaaS subscription itself (NOT the per-tenant invoices to
// riders). One row is expected; we use a fixed id="default" so upserts
// stay simple. Owner-portal-managed; read-only to tenants.
model PlatformBillingConfig {
  id              String   @id @default("default")
  legalName       String   @default("Equiwings Technologies Pvt Ltd")
  gstin           String?  // e.g. 29ABCDE1234F1Z5 — 15 chars
  hsnCode         String?  @default("9984") // SAC for "Education services" (sample default)
  panNo           String?  // standalone PAN for non-GST invoices
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  pincode         String?
  country         String   @default("IN")
  // Billing email + support email shown on invoices and in welcome flows.
  billingEmail    String?
  supportEmail    String?
  // Invoice numbering. Prefix + zero-padded counter — bumped atomically
  // each time the platform issues an invoice. Format: EW-2026-000123.
  invoicePrefix   String   @default("EW")
  invoiceCounter  Int      @default(0)
  // Default tax rate in basis points (1800 = 18%). India's standard GST
  // on SaaS services is 18% in 2026; legal entity / customer state may
  // require IGST vs CGST+SGST split — the actual invoice-time calc lives
  // in lib/saas-billing.ts and reads this default.
  defaultTaxBps   Int      @default(1800)
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}

// Platform-to-tenant invoice. Generated when a tenant is charged for the
// SaaS subscription (monthly/annual). Mirrors the structure of the
// tenant-internal Invoice table but lives on the platform side so the
// totals never get mixed with tenant revenue. GST is computed at issue
// time from PlatformBillingConfig.defaultTaxBps + the tenant's state.
// Platform-wide announcements. The owner publishes them; every tenant
// dashboard renders the latest non-dismissed entries. Use sparingly —
// each one shows up at the top of the dashboard until the user dismisses.
// Targeted via planFilter / roleFilter (CSV; "*" or null = everyone).
model Announcement {
  id           String   @id @default(cuid())
  title        String
  body         String
  // Optional CTA link rendered as a button on the dashboard card.
  ctaLabel     String?
  ctaHref      String?
  severity     String   @default("info") // info | success | warning | maintenance
  planFilter   String?  // CSV of plan keys, e.g. "starter,pro" — null = all
  roleFilter   String?  // CSV of tenant roles — null = all
  publishedAt  DateTime?
  expiresAt    DateTime?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dismissals   AnnouncementDismissal[]

  @@index([publishedAt, expiresAt])
}

// Per-user dismissal tracking so the same announcement doesn't re-appear
// after a "Got it" click. Composite primary key (userId, announcementId).
model AnnouncementDismissal {
  userId         String
  announcementId String
  dismissedAt    DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@index([announcementId])
}

// Net Promoter Score / qualitative feedback. Captured via the in-app
// widget; surfaces in the owner portal aggregate dashboard.
model NpsResponse {
  id        String   @id @default(cuid())
  userId    String?  // null when the user is no longer reachable (deletion sweep)
  orgId     String?
  score     Int      // 0–10
  comment   String?
  context   String?  // free-text page slug or feature name
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([score])
}

model SaasInvoice {
  id              String   @id @default(cuid())
  orgId           String
  number          String   @unique // e.g. EW-2026-000123
  periodStart     DateTime
  periodEnd       DateTime
  plan            String   // starter | pro | enterprise — snapshot
  // Amounts in INR rupees. Subtotal + tax = total. We snapshot the line
  // text so a later plan rename doesn't retroactively mutate old invoices.
  description     String
  subtotal        Int
  taxBps          Int      // 1800 = 18%
  taxAmount       Int
  total           Int
  currency        String   @default("INR")
  // Tenant-side billing snapshot at issue time (frozen).
  billingName     String?
  billingGstin    String?
  billingEmail    String?
  billingState    String?
  // Status: due → paid (via Stripe/Razorpay) or void (manually cancelled).
  status          String   @default("due") // due | paid | void
  issuedAt        DateTime @default(now())
  paidAt          DateTime?
  // External payment ref — Razorpay subscription id or Stripe invoice id.
  externalRef     String?
  pdfUrl          String?

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, issuedAt])
  @@index([status, issuedAt])
}

// Platform team — runs the owner portal. Separate auth domain (separate cookie,
// separate session) from tenant Users to prevent any chance of cross-leak.
// Roles: OWNER_ADMIN (full), OWNER_EDITOR (no billing / no suspend), OWNER_BILLING.
model PlatformUser {
  id           String   @id @default(cuid())
  role         String   @default("OWNER_ADMIN") // OWNER_ADMIN | OWNER_EDITOR | OWNER_BILLING
  name         String
  email        String   @unique
  passwordHash String
  status       String   @default("active") // active | suspended
  twoFactor    Boolean  @default(false)
  // Base32-encoded TOTP shared secret. Populated by /owner/account/security
  // enrollment; cleared when the user disables 2FA.
  totpSecret   String?
  // Replay protection — counter step of the last accepted TOTP code. A
  // second login attempt with the same code (within the ±1 step window)
  // is rejected because it can't strictly increase this number.
  totpLastStep BigInt?
  // SHA-256 hashes of one-shot recovery codes. JSON array. Used as a
  // fallback when the user has lost their authenticator. Each entry is
  // removed when consumed so no code is reusable.
  totpRecoveryCodesJson Json?
  // Same purpose as User.tokenVersion — bumped on password reset / 2FA
  // disable / "sign out everywhere" to invalidate any active owner session.
  tokenVersion Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs           PlatformAuditLog[]
  passwordResetTokens OwnerPasswordResetToken[]
}

// Audit trail for platform-team actions only (separate from tenant AuditLog so
// the two streams never get mixed and either can be exported independently).
model PlatformAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // owner.tenant_created | owner.plan_changed | owner.feature_toggled | owner.tenant_suspended | ...
  orgId     String? // target org, when applicable
  before    String?
  after     String?
  ip        String?
  userAgent String?
  at        DateTime @default(now())

  actor PlatformUser? @relation(fields: [actorId], references: [id])

  @@index([orgId, at])
  @@index([at])
}

model Centre {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  slug      String   @unique
  address   String?
  gstNo     String?
  managerId String?
  settings  String?
  // PDF §3 — Emergency Contact Board. JSON array of
  // { label, number, type } so each centre lists its on-call vet, nearest
  // equine hospital, ambulance, electricity / water emergency, etc.
  emergencyContactsJson Json?
  // IANA timezone for centre-local day boundaries (workload-cap bucketing,
  // "today" windows). Server runs in UTC; without this, day-bucketing is off
  // by the local offset (IST = +05:30). Defaults to India.
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org              Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users            User[]
  riders           Rider[]
  staff            Staff[]
  batches          Batch[]
  horses           Horse[]
  medicines        Medicine[]
  tasks            Task[]
  facilities       Facility[]
  feePlans         FeePlan[]
  invoices         Invoice[]
  certificates     Certificate[]
  assessments      Assessment[]
  progressLevels   ProgressLevel[]
  exams            Exam[]
  examSittings     ExamSitting[]
  scoringTemplates ScoringTemplate[]
  staffAttendances StaffAttendance[]
  leaveRequests    LeaveRequest[]
  equipmentStocks  EquipmentStock[]
  events           Event[]
  vendors          Vendor[]
  expenses         Expense[]
  lessons          Lesson[]
  feedPlans        FeedPlan[]
  vetVisits        VetVisit[]
  requisitions     Requisition[]
  shortLinks       ShortLink[]
  gateEvents       StaffGateEvent[]
  separationNotices SeparationNotice[]
  employeeAdvances  EmployeeAdvance[]
  checklistTemplates ChecklistTemplate[]
  checklistSubmissions ChecklistSubmission[]
  monthlySkillCatalogs MonthlySkillCatalog[]
  salaryPayments    SalaryPayment[]
  salaryStructures  SalaryStructure[]
  coachDailyUpdates CoachDailyUpdate[]
  employeeOnboardings EmployeeOnboarding[]
  venueTrips        VenueTrip[]
  auditRuns         AuditRun[]
}

// Role is a string union enforced at the app layer (see lib/roles.ts).
// SQLite doesn't support Prisma enums; on Postgres you can convert this to a native enum.

model User {
  id           String   @id @default(cuid())
  centreId     String?  // null for HQ super admins
  // Explicit org binding for HQ users whose centreId is null (SUPER_ADMIN).
  // Centre-scoped users derive their org via centre.orgId; the column is
  // optional so existing rows pre-backfill continue to work. New
  // SUPER_ADMIN provisioning sets this; tenancy checks (suspended-tenant
  // block, owner impersonation belongs-check) prefer it when present and
  // fall back to centre.orgId when absent.
  orgId        String?
  role         String   // Role (lib/roles.ts)
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  status       String   @default("active") // active | suspended
  twoFactor    Boolean  @default(false)
  // TOTP secret for tenant-side 2FA. Same shape as PlatformUser TOTP
  // (base32-encoded shared secret, last-step replay protection,
  // hashed recovery codes). Cleared when the user disables 2FA.
  totpSecret               String?
  totpLastStep             BigInt?
  totpRecoveryCodesJson    Json?
  // DPDPA Section 12 right-to-erasure. When set, the user has formally
  // requested account deletion. A 30-day grace window lets the user
  // cancel — the sweep at lib/sweeps.ts:sweepDpdpaDeletions hard-deletes
  // after the grace expires. While in this state the session is killed
  // (getSession sees status≠active via the deletion gate) and the user
  // can sign in only to cancel the request.
  deletionRequestedAt DateTime?
  // Email-verification gate. Null when a verified email is on file
  // (legacy rows + admin-created users with status="active" treated as
  // verified). Non-null = pending: the verifyEmailToken row is the active
  // proof and certain sensitive ops (impersonation target, password
  // reset trigger) are blocked until verification.
  emailVerifiedAt DateTime?
  // Set true whenever HQ generates a temp password (create / reset). The
  // session middleware forces the user through /account/rotate on next sign-in
  // before reaching any other page. Cleared once they pick a new password.
  mustChangePassword Boolean @default(false)
  // Monotonic counter embedded in every JWT for this user. Incrementing
  // invalidates every active session for the user at once — used on
  // password reset / "sign out everywhere". Without this, a stolen JWT
  // cookie remains valid until expiry even after a forced password change.
  tokenVersion Int @default(0)
  // Per-user notification delivery preferences. JSON shape:
  //   { inApp: true, email: true, sms: false, whatsapp: true,
  //     quietHoursStart: "22:00", quietHoursEnd: "07:00" }
  // Missing fields fall back to safe defaults in lib/notify-prefs.ts.
  notifPrefsJson Json?
  // Avatar URL, served from the upload route. Empty falls back to initials.
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  centre   Centre?  @relation(fields: [centreId], references: [id])
  org      Organisation? @relation("HqUsers", fields: [orgId], references: [id])
  rider    Rider?
  staff    Staff?

  auditLogs        AuditLog[]
  notifications    Notification[]
  staffAttendances StaffAttendance[]
  leaveRequests    LeaveRequest[]
  parentLinks      ParentLink[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens EmailVerifyToken[]
  announcementDismissals AnnouncementDismissal[]
  npsResponses           NpsResponse[]
  vetVisits        VetVisit[]
  requisitions     Requisition[]
  gateEvents       StaffGateEvent[] @relation("StaffGateStaff")
  separationNotices SeparationNotice[] @relation("SeparationUser")
  advances          EmployeeAdvance[]  @relation("EmployeeAdvanceUser")
  salaryPayments    SalaryPayment[]    @relation("SalaryPaymentUser")
  salaryStructures  SalaryStructure[]  @relation("SalaryStructureUser")
  coachDailyUpdates CoachDailyUpdate[] @relation("CoachDailyUpdateCoach")
  auditRuns         AuditRun[]         @relation("AuditRunInspector")
  batchShiftDecisions BatchShiftRequest[] @relation("BatchShiftDecidedBy")

  // Admin /users and /approvals filter by (centreId, status) — pending
  // approvals list, centre staff roster. Without this it's a scan-and-filter.
  @@index([centreId, status])
  // HQ rollups + getOrgIdForSession() lookups read User.orgId directly.
  @@index([orgId])
}

// Public forgot-password flow. We mint a SHA-256-hashed token on request;
// the email/SMS carries the plaintext. The unhashed value is never stored.
// Single-use: tokenUsedAt flips on first redeem. 30-min expiry by default.
model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  // SHA-256 of the plaintext token. We compare a fresh hash of the inbound
  // value against this column at redeem time.
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Email verification token. Same shape as PasswordResetToken — SHA-256
// hashed, single-use, 7-day TTL. Issued at user creation (super-admin
// onboarding + new admin-created users) and on email-change requests.
// Verification flips User.emailVerifiedAt and consumes the row.
model EmailVerifyToken {
  id        String   @id @default(cuid())
  userId    String
  email     String   // snapshot of the address being verified (in case it changes mid-flow)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Same shape as PasswordResetToken but for PlatformUser (owner portal). Kept
// as a separate model so the FK constraint can cascade properly and the two
// auth domains never share table state.
model OwnerPasswordResetToken {
  id          String   @id @default(cuid())
  ownerId     String
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime @default(now())

  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, expiresAt])
}

// ──────────────────────────────────────────────────────────────────────────
// RIDERS (AMS §4.1)
// ──────────────────────────────────────────────────────────────────────────

model Rider {
  id             String    @id @default(cuid())
  centreId       String
  userId         String?   @unique
  // Personal
  firstName      String
  lastName       String
  photoUrl       String?
  dob            DateTime
  placeOfBirth   String?
  nationality    String?
  gender         String?   // male | female | other
  maritalStatus  String?
  // ID. aadhaarNo holds the full number encrypted at rest (lib/pii.ts,
  // AES-256-GCM, "v1." prefix) once PII_ENCRYPTION_KEY is provisioned; legacy
  // rows stay plaintext until the backfill runs. The UI never reads aadhaarNo
  // directly — it shows aadhaarLast4 (masked) and only decrypts for the edit
  // form. aadhaarDocUrl is a storage path to the scan, not the number.
  aadhaarNo      String?
  aadhaarLast4   String?   // last 4 digits, for masked display without decrypting
  aadhaarDocUrl  String?
  // Contact
  mobile         String
  email          String?
  // Preferred language for parent communications (SMS / WhatsApp / email).
  // Two-letter ISO 639-1 code; lib/sms.ts looks up the matching template
  // body in lib/i18n-sms.ts. Defaults to "en" when null.
  preferredLanguage String?  // en | hi | ta | te | bn | mr | gu | kn | ml | pa
  school         String?   // PRD §4 Module 1 — name of the rider's school
  education      String?
  occupation     String?
  // Address
  addressPresent   String?
  addressPermanent String?
  pincode          String?
  // Parents
  fatherName     String?
  fatherPhone    String?
  motherName     String?
  motherPhone    String?
  // Emergency
  emergencyName  String?
  emergencyPhone String?
  // Anthropometrics — latest measurement only. Historical entries live in
  // BmiMeasurement so a rider's growth trend is preserved.
  heightCm       Float?
  weightKg       Float?
  bmi            Float?
  bmiMeasuredAt  DateTime?
  // Medical
  medicalNotes   String?
  allergies      String?
  // Riding profile
  currentLevel   String?   // links logically to ProgressLevel.name
  joiningDate    DateTime  @default(now())
  batchId        String?
  coachId        String?
  // State / national rider IDs. Optional — only riders competing at state
  // or above need one. Tracked at the rider level (one per rider) rather
  // than via Accreditation (which is per-card / per-membership).
  stateRiderId   String?
  efiRiderId     String?
  // Indemnity (audit trail)
  indemnitySignedAt   DateTime?
  indemnitySignerIp   String?
  indemnitySignerUa   String?
  indemnityDocUrl     String?
  indemnityVersion    String?
  // Content-of-consent for the indemnity step — what was typed + which
  // versioned texts were shown at sign time. Pairs with the columns above
  // (which capture WHEN/FROM-WHERE the signature happened). Schema:
  //   { signature, indemnityVersion, nocVersion, nocAgreed, agreedAt }
  // Null for pre-2026 records that pre-date the column.
  indemnityConsentJson Json?
  // Click-to-accept tracking for T&C + Rules. Version is the LegalText
  // row's `version` that was live when the rider accepted; lets HQ swap
  // the published text later without re-prompting old riders.
  tcsAcceptedAt       DateTime?
  tcsVersion          String?
  rulesAcceptedAt     DateTime?
  rulesVersion        String?
  // DPDPA Section 9 — verifiable parental consent for minors. Captured at
  // registration when dob makes the rider < 18. Stored together as one
  // JSON blob so the audit trail keeps the exact wording the parent
  // agreed to (the text changes when ToS rev bumps). Schema:
  //   { signedAt, parentName, parentRelation, parentPhone, ip, ua,
  //     consentText: "...", consentVersion: "v1" }
  // Null for adult riders or pre-DPDPA records.
  parentalConsentJson Json?
  // Status
  status         String    @default("pending_payment") // pending_approval | pending_payment | active | suspended | cancelled | rejected
  registrationPaid Boolean @default(false)
  // True when the rider came in via the public self-enrol link (vs. created
  // by staff). Self-enrolled riders land in status="pending_approval" and a
  // School Admin / Centre Manager must approve before they progress to
  // pending_payment. See app/api/onboarding + app/(admin)/enrolments.
  selfEnrolled   Boolean   @default(false)
  approvedByUserId String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  centre   Centre @relation(fields: [centreId], references: [id])
  user     User?  @relation(fields: [userId], references: [id])
  batch    Batch? @relation(fields: [batchId], references: [id])
  attendances Attendance[]
  invoices    Invoice[]
  skillStatus RiderSkillStatus[]
  monthlySkillMarks MonthlySkillMark[]
  certificates Certificate[]
  horseAllocations HorseAllocation[]
  exams       Exam[]
  parentLinks ParentLink[]
  eventRegistrations EventRegistration[]
  accreditations Accreditation[]
  batchShiftRequests BatchShiftRequest[]

  @@index([centreId])
  @@index([batchId])
  @@index([status])
  // Composite for the common centre+status combo — admin rider lists, sweeps
  // ("active riders in this centre"), birthday roll-ups. Covers the two
  // singletons above when the query uses both columns, so they could be
  // dropped if you want — left them for now as zero-cost duplication.
  @@index([centreId, status])
}

model Batch {
  id        String  @id @default(cuid())
  centreId  String
  name      String
  dayOfWeek String  // CSV: "Mon,Wed,Fri"
  startTime String  // "06:00"
  endTime   String  // "07:00"
  coachId   String?
  level     String?
  createdAt DateTime @default(now())

  centre   Centre  @relation(fields: [centreId], references: [id])
  riders   Rider[]
  attendances Attendance[]
  lessons  Lesson[]
  shiftRequestsFrom BatchShiftRequest[] @relation("BatchShiftFrom")
  shiftRequestsTo   BatchShiftRequest[] @relation("BatchShiftTo")

  @@index([centreId])
}

model Attendance {
  id        String   @id @default(cuid())
  riderId   String
  batchId   String
  date      DateTime
  status    String   // present | absent | late | excused
  reason    String?
  markedBy  String?
  markedAt  DateTime @default(now())

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id])

  @@unique([riderId, batchId, date])
  @@index([date])
  // Attendance roster is loaded per-batch per-day; the unique index leads with
  // riderId so batchId isn't a usable prefix for the (batchId, date) filter.
  @@index([batchId, date])
}

// A specific instance of a Batch on a given date. Batches define the
// recurring slot (Mon/Wed/Fri 6–7am with this coach); Lesson is the
// concrete session that happens at a specific date. Lessons let us
// cancel/reschedule a single occurrence, swap coach for one day, mark
// the session complete, and bind per-rider horse allocations to the
// session — none of which the static Batch row can model.
model Lesson {
  id        String   @id @default(cuid())
  centreId  String
  batchId   String?  // null when the lesson was created ad-hoc (make-up, clinic)
  date      DateTime // the date+start time of the session
  endAt     DateTime
  coachId   String?  // overrides batch.coachId for this one session
  status    String   @default("scheduled") // scheduled | completed | cancelled | rescheduled
  notes     String?
  // When status=rescheduled, points at the make-up Lesson that replaces it.
  rescheduledToId String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centre Centre @relation(fields: [centreId], references: [id])
  batch  Batch? @relation(fields: [batchId], references: [id])
  allocations HorseAllocation[]

  @@index([centreId, date])
  @@index([batchId, date])
}

// ──────────────────────────────────────────────────────────────────────────
// PROGRESS & ASSESSMENTS (AMS §4.3, §4.4)
// ──────────────────────────────────────────────────────────────────────────

model ProgressLevel {
  id        String @id @default(cuid())
  centreId  String
  name      String
  order     Int
  centre    Centre @relation(fields: [centreId], references: [id])
  skills    Skill[]
  assessments Assessment[]

  @@unique([centreId, name])
}

model Skill {
  id          String @id @default(cuid())
  levelId     String
  discipline  String  // normal | gymkhana | dressage | tent_pegging | endurance | jumping
  name        String
  description String?

  level   ProgressLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  riderStatus RiderSkillStatus[]
}

model RiderSkillStatus {
  riderId    String
  skillId    String
  status     String   // not_started | in_progress | mastered
  coachNotes String?
  videoUrl   String?
  updatedAt  DateTime @updatedAt

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([riderId, skillId])
}

model Assessment {
  id          String   @id @default(cuid())
  centreId    String
  levelId     String?
  type        String   // theory | practical | oral | stable_mgmt
  scheduledAt DateTime
  examinerId  String?
  horseId     String?
  facilityId  String?
  status      String   @default("scheduled") // scheduled | completed | cancelled

  centre Centre         @relation(fields: [centreId], references: [id])
  level  ProgressLevel? @relation(fields: [levelId], references: [id])
}

// ──────────────────────────────────────────────────────────────────────────
// STAFF (CMS §4.8)
// ──────────────────────────────────────────────────────────────────────────

model Staff {
  id           String   @id @default(cuid())
  centreId     String
  userId       String   @unique
  role         String   // Role (lib/roles.ts)
  joiningDate  DateTime @default(now())
  kycDocsJson  Json?
  salaryBand   String?
  status       String   @default("active")

  // KYC + clearance documents. Stored as upload URLs (lib/storage.ts).
  // Aadhaar is the Indian national ID — captured for every staff hire.
  // Police verification is a govt-issued clearance certificate; mandatory
  // before letting any staff member work with minors at the club.
  aadhaarUrl              String?
  policeVerificationUrl   String?
  policeVerifiedAt        DateTime?

  centre Centre @relation(fields: [centreId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([centreId])
}

// Employee self-registration / onboarding. An admin generates a tokenised link
// (one per prospective hire); the employee fills personal details, uploads KYC +
// employment documents, accepts the agreement and a typed-name self-declaration,
// and submits. Admin reviews and approves → creates the User + Staff records.
// Mirrors the rider self-enrolment + external-entry-token patterns.
model EmployeeOnboarding {
  id        String   @id @default(cuid())
  centreId  String
  tokenHash String   @unique // SHA-256 of the link token; used to validate the URL
  // Plaintext token kept so the admin can re-copy / re-share the link later
  // (Copy + WhatsApp from the list). Low-sensitivity: it only opens a public
  // registration form. Nulled once the form is submitted.
  shareToken String?
  expiresAt DateTime
  status    String   @default("draft") // draft | submitted | approved | rejected

  // Personal
  fullName         String?
  fatherName       String?
  emergencyContact String?
  dob              DateTime?
  permanentAddress String?
  email            String?
  maritalStatus    String?
  aadhaarNumber    String?
  panNumber        String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  prevEmployment   String?
  agreedSalary     Float?
  foodCharges      Float?
  otherAllowances  String?
  pfEsicConsent    Boolean  @default(false)
  policeVerificationDetails String?
  employmentType   String?  // full_time | trainee_stipend
  dateOfJoining    DateTime?
  references       String?

  // Uploaded document URLs (lib/storage.ts)
  photoUrl              String?
  aadhaarUrl            String?
  panUrl                String?
  bankProofUrl          String?
  prevEmploymentUrl     String?
  policeVerificationUrl String?
  characterCertUrl      String?

  // Consent + legal declaration
  agreementAccepted   Boolean @default(false)
  declarationAccepted Boolean @default(false)
  declarationName     String? // typed full name = legal e-acceptance

  // Lifecycle
  createdByUserId  String?
  intendedRole     String?  // role chosen at link generation; pre-fills approval
  submittedAt      DateTime?
  reviewedByUserId String?
  reviewNotes      String?
  approvedAt       DateTime?
  createdStaffId   String?
  createdUserId    String?  // the login created on approval — for "my documents"
  // Post-approval completion of any blank fields: 15-day deadline, waived item
  // keys (admin/super-admin can waive what doesn't apply), overdue-notify dedup.
  documentsDueAt    DateTime?
  waivedItemsJson   Json?    // string[] of item keys waived by an admin
  overdueNotifiedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  centre Centre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@index([centreId, status])
  @@index([createdUserId])
}

// ──────────────────────────────────────────────────────────────────────────
// HORSES & FACILITIES (CMS §4.13, §4.16)
// ──────────────────────────────────────────────────────────────────────────

model Horse {
  id          String   @id @default(cuid())
  centreId    String
  name        String
  breed       String?
  sex         String?
  ageYears    Int?
  heightHh    Float?
  microchip   String?
  // Equestrian Federation of India horse ID. Optional — only horses
  // competing at national or above need one. Different from microchip
  // (which is the implanted RFID).
  efiHorseId  String?
  // Free-text "home club" — useful for visiting / privately-owned horses
  // that belong to another club but are stabled here temporarily. Distinct
  // from `centreId` which is the operational owner inside Equiwings.
  homeClub    String?
  ownership   String?  // club | private
  // PDF §4 "Insurance Records" — structured fields rather than just a URL.
  // Expiry is surfaced via lib/sweeps.ts so the manager gets a heads-up
  // before the policy lapses.
  insuranceDocUrl     String?
  insurerName         String?
  insurancePolicyNo   String?
  insurancePremium    Float?   // INR
  insuranceValidFrom  DateTime?
  insuranceValidTo    DateTime?
  stableNo    String?
  diet        String?
  status      String   @default("active") // active | rest | retired
  createdAt   DateTime @default(now())

  centre      Centre @relation(fields: [centreId], references: [id])
  allocations HorseAllocation[]
  usages      MedicineUsage[]
  farrierVisits      FarrierVisit[]
  healthLogs         HorseHealthLog[]
  injuries           InjuryLog[]
  vaccinationSchedules VaccinationSchedule[]
  feedPlan             FeedPlan?
  vetVisits            VetVisit[]
  tests              HorseTest[]
  dewormingSchedules DewormingSchedule[]
  checklistSubmissions ChecklistSubmission[]

  @@index([centreId])
}

// Lab tests done on a horse: Coggins (EIA), Glanders, Urination. Some are
// compliance-driven (Coggins + Glanders are mandatory for inter-state /
// competition movement in India), others are routine vet diagnostics
// (Urination = urinalysis, run when systemic illness is suspected).
//
// Distinct from VetVisit prescriptions: a test is a one-time procedure
// with a pass/fail outcome, often run by an external lab.
model HorseTest {
  id          String   @id @default(cuid())
  horseId     String
  // coggins | glanders | urination
  testType    String
  // negative | positive | pending | inconclusive
  result      String   @default("pending")
  testedAt    DateTime @default(now())
  // Compliance tests (Coggins / Glanders) repeat on a cadence; this is
  // when the next test is due. Null for one-off diagnostics like urination.
  nextDueAt   DateTime?
  labName     String?
  reportUrl   String?
  notes       String?
  recordedByUserId String

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([horseId, testType, testedAt])
}

// ──────────────────────────────────────────────────────────────────────────
// COURSES & STAFF CERTIFICATIONS (PRD — Groom/Coach Management & Courses)
// ──────────────────────────────────────────────────────────────────────────
// Internal training programmes a club runs for its own staff — e.g. "Groom
// Level 1", "Stable Safety Refresher". Each Course has enrolments (which staff
// signed up) and certifications (who passed, when, valid-until).
model Course {
  id           String   @id @default(cuid())
  centreId     String
  title        String
  description  String?
  targetRoles  String?  // CSV of Role keys this course is aimed at
  durationHrs  Int?
  passingMark  Int?     // optional pct
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrolments     CourseEnrolment[]
  certifications StaffCertification[]

  @@index([centreId, active])
}

model CourseEnrolment {
  id         String   @id @default(cuid())
  courseId   String
  userId     String   // staff user
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  status     String   @default("enrolled") // enrolled | in_progress | completed | dropped
  finalMark  Int?     // 0–100

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId, status])
}

// Issued certificate of completion. Decoupled from CourseEnrolment so we can
// also record external certifications (BHS / EFI / EQ-IND etc) by leaving
// courseId null and filling in issuer fields.
model StaffCertification {
  id           String   @id @default(cuid())
  centreId     String
  userId       String
  courseId     String?
  title        String
  issuer       String?  // external issuer name when courseId is null
  serialNo     String?  @unique
  issuedAt     DateTime @default(now())
  validUntil   DateTime?
  fileUrl      String?

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([centreId, userId])
  @@index([validUntil])
}

// ──────────────────────────────────────────────────────────────────────────
// FACILITY BOOKING (PRD — Exam Logistics & Scheduling)
// ──────────────────────────────────────────────────────────────────────────
// A facility (indoor arena, outdoor arena, classroom) booked for a window.
// Insert enforces no overlap per (facilityId × [startAt, endAt)).
model FacilityBooking {
  id          String   @id @default(cuid())
  facilityId  String
  centreId    String
  purpose     String   // exam | competition | lesson | maintenance | other
  refType     String?  // exam | competition | task | other (free-text)
  refId       String?  // foreign key into the referencing module
  title       String
  startAt     DateTime
  endAt       DateTime
  createdBy   String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([facilityId, startAt])
  @@index([centreId, startAt])
}

// ──────────────────────────────────────────────────────────────────────────
// APPROVAL WORKFLOW
// ──────────────────────────────────────────────────────────────────────────
// Generic multi-step approval queue. Today wired to high-value asset
// issuances + (future) PO requests, but the entityType / entityId free-text
// pattern means we can hang it off anything without bloating Asset.
model ApprovalRequest {
  id            String   @id @default(cuid())
  centreId      String
  entityType    String   // asset_issuance | po_request | event_expense | ...
  entityId      String   // free-text id into the originating table
  title         String
  body          String?
  requestedBy   String   // user.id
  status        String   @default("pending") // pending | approved | rejected | cancelled
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([centreId, status])
  @@index([entityType, entityId])
  @@index([requestedBy])
}

// ──────────────────────────────────────────────────────────────────────────
// CONSUMABLES INVENTORY (PDF §2 — Wound & Bandaging Supplies)
// ──────────────────────────────────────────────────────────────────────────
// Separate from Asset (durable, one row per physical item) and Medicine
// (regulated drugs with batch + expiry tracking). Consumables are stuff like
// gauze, vet wrap, cotton, disposable gloves, bandage scissors — usage drops
// the count, reorder threshold triggers a sweep notification.
model Consumable {
  id               String   @id @default(cuid())
  centreId         String
  name             String   // "Sterile gauze pad — 10x10cm"
  category         String   // bandage | dressing | hygiene | tool | other
  unit             String   // "pad" | "roll" | "bottle" | "pack" | "pair" | "each"
  qty              Int      @default(0)
  reorderThreshold Int      @default(10)
  supplier         String?
  storageLocation  String?
  notes            String?
  active           Boolean  @default(true) // soft-delete: hidden from lists when false
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  movements ConsumableMovement[]

  @@index([centreId, category])
  @@index([centreId, qty])
}

// Stock movements — in (purchase), out (used), adjust (correction, theft, etc).
// Provides an audit-able usage history per item.
model ConsumableMovement {
  id           String   @id @default(cuid())
  consumableId String
  direction    String   // in | out | adjust
  qty          Int      // positive integer; direction encodes sign
  reason       String?  // "first-aid kit refill", "stock count correction"
  byUserId     String?
  at           DateTime @default(now())

  consumable Consumable @relation(fields: [consumableId], references: [id], onDelete: Cascade)

  @@index([consumableId, at])
}

// ──────────────────────────────────────────────────────────────────────────
// COMPETITION OPERATIONS (PDF §4 — Event Operations)
// ──────────────────────────────────────────────────────────────────────────
// Four small models that flesh out the existing Competition flow:
//   StartListEntry  — running order per class on event day
//   PrizeAward      — what was awarded for each placement
//   Sponsor         — who funded the event + their contribution
// "Draw of lots" is handled inline: a single Competition-level boolean
// (`drawCompleted`) plus per-entry `drawOrder`. No separate table needed.




// PDF §4 — Farrier Schedule. One row per visit (past or planned). Combined
// with the FARRIER role + farriery feature flag this completes the spec.
// `scheduledAt` is when the visit is *planned*; `completedAt` records when it
// actually happened. `farrierName` is denormalised so historical visits
// survive a farrier leaving the club.
model FarrierVisit {
  id           String   @id @default(cuid())
  centreId     String
  horseId      String
  farrierName  String
  farrierUserId String? // null for external farriers we don't onboard as users
  scheduledAt  DateTime
  completedAt  DateTime?
  workType     String   // trim | shoe_full | shoe_partial | reset | other
  hoofNotes    String?  // e.g. "left fore — slight crack, sealed"
  cost         Float?
  nextDueAt    DateTime? // computed at completion (typically +6 weeks)
  status       String   @default("scheduled") // scheduled | completed | skipped | cancelled
  createdBy    String?
  createdAt    DateTime @default(now())

  horse  Horse  @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([centreId, scheduledAt])
  @@index([horseId, scheduledAt])
  @@index([status])
}

// PDF §4 — Horse Temperature Chart. Daily vitals: temp, heart rate,
// respiration, weight if measured. Designed to be chartable so the vet can
// spot trends; we store one row per check-in (a horse may be checked AM/PM
// when ill so we don't dedup by date).
model HorseHealthLog {
  id            String   @id @default(cuid())
  horseId       String
  centreId      String
  recordedAt    DateTime @default(now())
  recordedBy    String?  // user.id
  tempC         Float?   // normal range 37.2 – 38.3
  heartRateBpm  Int?     // normal 28 – 44 at rest
  respirationRpm Int?    // normal 8 – 16 at rest
  weightKg      Float?
  appetite      String?  // good | reduced | none
  manure        String?  // normal | dry | loose | watery | none
  notes         String?

  horse  Horse  @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([horseId, recordedAt])
  @@index([centreId, recordedAt])
}

// PDF §4 — Injury Treatment Log. Tracks an injury from discovery through
// recovery. `subjectType` is "horse" or "rider" so we don't need two parallel
// models; subjectId points at the right table by convention.
model InjuryLog {
  id            String   @id @default(cuid())
  centreId      String
  subjectType   String   // horse | rider
  subjectId     String
  occurredAt    DateTime
  location      String?  // e.g. "left fore fetlock"
  severity      String   @default("minor") // minor | moderate | severe
  cause         String?
  initialNotes  String
  treatmentJson Json?  // serialised array of { at, by, treatment, notes }
  recoveredAt   DateTime?
  status        String   @default("active") // active | recovering | recovered | chronic
  reportedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  horse Horse? @relation(fields: [horseSubjectId], references: [id], onDelete: SetNull)
  // Prisma needs an explicit relation column for the optional horse link; we
  // mirror subjectId into horseSubjectId when subjectType="horse" so we can
  // surface "all injuries for this horse" with a fast join.
  horseSubjectId String?

  @@index([centreId, occurredAt])
  @@index([subjectType, subjectId])
  @@index([status])
}

// PDF §4 — Vaccination Schedules. Records the *plan* (per horse, per vaccine
// type). When an actual dose is administered via MedicineUsage, the sweep
// re-stamps `lastGivenAt` and recomputes `nextDueAt = lastGivenAt + intervalDays`.
model VaccinationSchedule {
  id           String   @id @default(cuid())
  centreId     String
  horseId      String
  vaccineKey   String   // tetanus | ehv | influenza | rabies | dewormer | custom
  vaccineLabel String   // free-text label, copied from Medicine.name when known
  intervalDays Int      // 365 for tetanus annual, 180 for biannual, etc.
  firstDueAt   DateTime?
  lastGivenAt  DateTime?
  nextDueAt    DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@unique([horseId, vaccineKey])
  @@index([centreId, nextDueAt])
}

model HorseAllocation {
  id         String   @id @default(cuid())
  horseId    String
  riderId    String?
  purpose    String   // lesson | exam | competition
  // When purpose=lesson and the allocation is for a concrete session,
  // this points at the Lesson row. Older allocations created before the
  // Lesson model existed leave it null and use startAt/endAt directly.
  lessonId   String?
  startAt    DateTime
  endAt      DateTime
  notes      String?
  createdBy  String?
  createdAt  DateTime @default(now())

  horse  Horse   @relation(fields: [horseId], references: [id])
  rider  Rider?  @relation(fields: [riderId], references: [id])
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([horseId, startAt])
  @@index([lessonId])
  // Student/parent portals + per-rider allocation views filter on riderId
  // (nullable FK, not auto-indexed).
  @@index([riderId, startAt])
}

// Per-horse feeding plan. JSON-as-text keeps the SQLite-portable rule the
// rest of the schema follows; a ration is a list of items with quantity
// + unit. `Horse.diet` was a free-text string — kept for now (existing
// data) but new entries should go through FeedPlan so the daily view +
// vet review can read structured data.
//
// Shape of rationsJson:
// [
//   { "time": "morning", "items": [{ "feed": "Hay", "qty": 5, "unit": "kg" }] },
//   { "time": "noon",    "items": [{ "feed": "Oats", "qty": 2, "unit": "kg" }] },
//   { "time": "evening", "items": [...] }
// ]
model FeedPlan {
  id          String   @id @default(cuid())
  centreId    String
  horseId     String   @unique // one active plan per horse; swap in-place
  rationsJson Json
  notes       String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  centre Centre @relation(fields: [centreId], references: [id])
  horse  Horse  @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([centreId])
}

model Facility {
  id       String @id @default(cuid())
  centreId String
  name     String
  type     String // indoor_arena | outdoor_arena | classroom | stable
  capacity Int?

  centre Centre @relation(fields: [centreId], references: [id])
}

// ──────────────────────────────────────────────────────────────────────────
// TACK / SCHOOL ASSETS (CMS §4.10, §4.11)
// ──────────────────────────────────────────────────────────────────────────

// Individual-Asset tracking (Asset / AssetIssuance / AssetMaintenance) was
// removed when the /tack route was folded into the bulk EquipmentStock
// flow. Quantity-only inventory turned out to match how clubs actually
// reason about gear ("we own 4 polo saddles") and the parallel system
// added confusion without enough value. Approval rows of entityType
// "asset_issuance" remain in the table as soft history; no new ones
// will be minted.

// ──────────────────────────────────────────────────────────────────────────
// VET (CMS §4.12)
// ──────────────────────────────────────────────────────────────────────────

model Medicine {
  id              String   @id @default(cuid())
  centreId        String
  name            String
  generic         String?
  category        String   // nsaid | antibiotic | wound | supplement | vaccine | dewormer
  schedule        String?  // schedule_h | schedule_x | null
  batchNo         String
  mfgDate         DateTime?
  expDate         DateTime
  qty             Int      @default(0)
  reorderThreshold Int     @default(5)
  supplier        String?
  storageLocation String?
  coldChain       Boolean  @default(false)
  active          Boolean  @default(true) // soft-delete: hidden from lists when false
  deletedAt       DateTime?

  centre        Centre            @relation(fields: [centreId], references: [id])
  usages        MedicineUsage[]
  prescriptions VetPrescription[]

  @@index([centreId, expDate])
}

model MedicineUsage {
  id              String   @id @default(cuid())
  medicineId      String
  horseId         String
  vetUserId       String
  dose            String
  route           String   // oral | im | iv | topical
  reason          String?
  usedAt          DateTime @default(now())
  withdrawalUntil DateTime?
  // Client-generated idempotency key: a double-click / network retry of the
  // same submit re-sends the same key; the unique index turns the duplicate
  // into a replay instead of a second stock decrement.
  requestKey      String?  @unique

  medicine Medicine @relation(fields: [medicineId], references: [id])
  horse    Horse    @relation(fields: [horseId], references: [id])

  // Both FKs were unindexed (table had only requestKey @unique). The medicine
  // detail page reads usage by medicineId and the horse medical-history tab by
  // horseId — both order by usedAt desc — and this append-only table grows
  // with every prescription. Under RLS each scanned row also runs the via-fk
  // EXISTS(Medicine) check, so an unindexed seq scan compounds.
  @@index([medicineId, usedAt])
  @@index([horseId, usedAt])
}

// Vet visit — a journal entry the on-site or visiting vet records against a
// horse. Carries the diagnostic notes and a set of VetPrescription rows that
// link back to the centre's Medicine inventory (so dispensing a prescribed
// med decrements stock, and the horse's history shows what was actually given).
// Distinct from MedicineUsage (which is the "give one dose now" event) — a
// visit can prescribe multiple meds over a duration, and may exist without
// any meds (purely diagnostic).
model VetVisit {
  id          String   @id @default(cuid())
  centreId    String
  horseId     String
  vetUserId   String
  visitDate   DateTime @default(now())
  reason      String?  // chief complaint / why the vet was called
  notes       String   // findings + diagnosis (free text)
  followUpAt  DateTime?
  createdAt   DateTime @default(now())

  centre        Centre            @relation(fields: [centreId], references: [id])
  horse         Horse             @relation(fields: [horseId], references: [id], onDelete: Cascade)
  vet           User              @relation(fields: [vetUserId], references: [id])
  prescriptions VetPrescription[]

  @@index([horseId, visitDate])
  @@index([centreId, visitDate])
}

model VetPrescription {
  id            String   @id @default(cuid())
  visitId       String
  // Nullable: vet may prescribe a med not in stock (will need ordering) or
  // free-text instructions. We always store the typed-in name for audit
  // even when medicineId is set.
  medicineId    String?
  medicineName  String
  dose          String   // e.g. "10 ml" / "2 sachets"
  route         String?  // oral | im | iv | topical
  durationDays  Int?
  frequency     String?  // "once daily" / "BID" / "as needed"
  notes         String?

  visit    VetVisit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicine Medicine? @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([medicineId])
}

// ──────────────────────────────────────────────────────────────────────────
// TASKS (CMS §4.9)
// ──────────────────────────────────────────────────────────────────────────

model Task {
  id          String   @id @default(cuid())
  centreId    String
  title       String
  description String?
  // Categorises the task — lets us pull "all dress rehearsals" or "all stable
  // cleaning tasks" with one query. PDF Phase-1 explicitly calls out dress
  // rehearsals; we don't model them as a separate table.
  kind        String?  // generic | dress_rehearsal | stable | feeding | rehearsal | …
  assigneeId  String?
  // Who delegated the task. Powers the "Tasks Given" view + the delegation
  // hierarchy (Super Admin → Admin/HR, Admin → Coach). Null for self-created
  // or system-generated tasks.
  assignedById String?
  dueAt       DateTime?
  // Immutable overdue anchor (set to the first dueAt the task is given, never
  // bumped by later dueAt edits). The board's overdue/escalated derivation
  // reads this so nudging dueAt forward can't cosmetically erase a task's
  // overdue history. Cleared if the due date is removed. Legacy rows are null
  // and fall back to dueAt.
  overdueSince DateTime?
  recurrence  String?
  // Set once, by sweepRecurringTasks, when this task has spawned its next
  // occurrence — the idempotency guard so the expander never double-generates
  // (even if the cron runs twice or overlaps). Null = not yet spawned.
  recurrenceSpawnedAt DateTime?
  status      String   @default("open") // open | in_progress | done | overdue | escalated
  proofUrl    String?
  // Stamped when status flips to done — lets the "Tasks Completed" view show
  // when, and feeds completion-rate reporting.
  completedAt DateTime?
  // Stamped by sweepTaskEscalation when an overdue task is escalated (manager +
  // delegator notified). Dedup guard so escalation fires once, and powers a
  // truthful "escalated" badge/filter without re-deriving from dueAt.
  escalatedAt DateTime?
  createdAt   DateTime @default(now())

  centre Centre @relation(fields: [centreId], references: [id])

  @@index([centreId, assignedById])
  @@index([centreId, assigneeId])
  // The two sweeps scan by these — escalation finds overdue-not-escalated,
  // recurrence finds due-not-spawned.
  @@index([status, escalatedAt])
  @@index([recurrence, recurrenceSpawnedAt])
}

// ──────────────────────────────────────────────────────────────────────────
// COMPETITIONS (§4.14)
// ──────────────────────────────────────────────────────────────────────────



// One round / heat / phase within a class. Examples:
//   • Jumping: round 1 + jump-off → two rows per class
//   • Eventing: dressage / cross-country / show-jumping → three rows
//   • Dressage: single round most of the time

// One row per (round, entry, fence number, effort). Captures fence-by-fence
// detail for show-jumping rounds. The aggregate `faults` on
// CompetitionRoundScore and CompetitionEntry remains canonical for
// placement — this table powers the detailed scoresheet and lets the
// frontend show "5 faults = 1 rail at jump 4 + 1 refusal at 7a".
//
// Faults math (FEI Table A):
//   • knockdown      = 4 faults
//   • 1st refusal    = 4 faults
//   • 2nd refusal    = 4 faults
//   • 3rd refusal    = elimination
//   • fall of horse or rider = elimination
//   • time over allowed = ceil((time − timeAllowedSec) / 4) faults
//
// We don't enforce eliminations programmatically — the judge marks it,
// and the API recomputes the aggregate `faults` on the round score.

// Dressage test catalog — SUPER_ADMIN curated. One row per official test
// (Prelim 14, Novice 27, Elementary 43...). Federation `body` tracks
// origin; centres can also add custom internal tests with body="custom".
//
// movementsJson shape:
//   [{ no: 1, letter: "A,X", description: "Enter working trot", coefficient: 1 },
//    { no: 2, letter: "C", description: "Track left, working trot rising", coefficient: 1 },
//    ...]
// collectiveMarksJson shape (end-of-test marks):
//   [{ name: "Paces", coefficient: 1 },
//    { name: "Impulsion", coefficient: 1 },
//    { name: "Submission", coefficient: 1 },
//    { name: "Rider position", coefficient: 1 }]
// maxScore = (sum of movement coefficients × 10) + (sum of collective coefficients × 10).

// One scoresheet per (round, entry, judge). Captures one judge's marks
// for one ride. marksJson is [{ no: 1, mark: 7.5, comment: "..." }, ...],
// collectiveMarksJson [{ name: "Paces", mark: 7, comment: "..." }, ...].
// `percentage` is server-computed at submit time.

// Gymkhana game template. A gymkhana day = N games per class. Riders
// play every game; combined ranking = sum of per-game positions.
// scoringType "time" → fastest wins (faults add penaltyPerFault seconds);
// scoringType "points" → highest points wins (judge-assigned).


// Course design — fence-by-fence layout. Renders as a strip chart on the
// round detail page + appears on the printed course program.

// Vet checks — pre/post-event horse soundness inspections.

// Stable allocation for visiting horses. Free-text horse/rider names
// because cross-tenant visitors don't have rows in Horse/Rider.

// Drug test (medication control) — chain-of-custody record. The lab
// result is stored as a status only; detailed reports stay with the lab.

// Protest / appeal record.

// External rider entry — submitted via the public competition page by
// visiting competitors who aren't users of the host academy. We hold them
// in a pending queue until the organiser approves; on approval, we mint
// a CompetitionEntry against a synthetic Rider row scoped to the host
// centre (so the rest of the system can render the start list etc.
// without special-casing externals).
//
// Two-step verification: the entrant gets a magic-link email; clicking it
// flips `verifiedAt`. Unverified entries get auto-purged after 7 days.

// Ticket tier for spectator sales. Owner-defined: name, price, capacity.
// Capacity null = unlimited. Public ticket-buy uses the tier's price to
// mint Razorpay orders; tickets without a price are "free" tickets that
// just need an email + a head-count.

// Issued ticket. One row per quantity (so "Family of 4 × 1" = 4 rows).
// QR code is just the ticket id — the scanner posts the id to /check-in
// and we flip checkedInAt + record the user who scanned.

// Competition officials — judges, TDs, course designers, stewards. Distinct
// from the per-ride judging mechanics above; this table records who was
// in which role at the show, for the official record + the printed program.
// One row per (competition, user, role). User can hold multiple roles in
// the same comp (e.g., judge in two classes + TD overall).

// Score for one (entry, round) pair. The aggregate that drives placement
// lives on CompetitionEntry; per-round detail lives here.

// ──────────────────────────────────────────────────────────────────────────
// FINANCE (§4.20)
// ──────────────────────────────────────────────────────────────────────────

model FeePlan {
  id                String  @id @default(cuid())
  centreId          String
  levelName         String
  monthlyAmount     Float
  registrationAmount Float

  centre Centre @relation(fields: [centreId], references: [id])

  @@unique([centreId, levelName])
}

model Invoice {
  id        String   @id @default(cuid())
  centreId  String
  riderId   String
  amount    Float
  gstAmount Float    @default(0)
  dueDate   DateTime
  status    String   @default("due") // due | paid | overdue | refunded
  kind      String   // registration | monthly | exam | event
  createdAt DateTime @default(now())

  centre   Centre   @relation(fields: [centreId], references: [id])
  rider    Rider    @relation(fields: [riderId], references: [id])
  payments Payment[]

  // fee-due sweep filters by (status, dueDate); without this index the query
  // does a full table scan on Invoice.
  @@index([status, dueDate])
  // Admin/finance views filter heavily by centre (+ status); FK columns are
  // NOT auto-indexed in Postgres, so index it explicitly.
  @@index([centreId, status])
  // Student/parent portals count unpaid invoices per rider on every load
  // (where riderId + status); no riderId-leading index existed.
  @@index([riderId, status])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String   // razorpay | cash | cheque | upi
  // Gateway/transaction reference. UNIQUE so a re-delivered webhook (or the
  // verify redirect racing the webhook) can't double-apply a payment — the
  // second insert hits P2002 and is treated as already-applied. Postgres
  // allows multiple NULLs, so cash payments without a ref are unaffected.
  txnRef    String?  @unique
  paidAt    DateTime @default(now())
  clearedAt DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId, paidAt])
  @@index([paidAt])
}

// ──────────────────────────────────────────────────────────────────────────
// CERTIFICATES (§4.21)
// ──────────────────────────────────────────────────────────────────────────

model Certificate {
  id        String   @id @default(cuid())
  centreId  String
  riderId   String
  // Source exam for promotion certificates. Optional so participation and
  // winner-style certs (issued without a formal exam) still fit the table.
  examId    String?
  // Source competition for winner / participation certificates. Issued
  // automatically when an entry is placed (1st/2nd/3rd) or when a comp is
  // marked complete (all non-withdrawn entries get participation certs).
  type      String   // promotion | participation | winner | event_attendance
  levelName String?
  serialNo  String   @unique
  pdfUrl    String?
  qrCode    String
  signedBy  String?
  // Bulk-issue grouping. When the bulk panel mints N certs from one
  // event/exam-sitting/competition, every cert in the batch shares this
  // value so we can show "Bulk batch · 27 issued · 14 Mar".
  batchTag  String?
  // Revocation — soft state so the verify page can render REVOKED instead
  // of a normal cert page. Hard delete is avoided so audit history stays.
  revokedAt DateTime?
  revokedBy String?
  revokeReason String?
  // Parent-notification tracking. Email is NOT auto-sent on cert issue —
  // staff click 'Send result to parent' on the cert detail/list page when
  // they're ready. resultEmailSentAt is set on the click; if null the
  // UI shows the action as primary (otherwise as 'Resend').
  resultEmailSentAt DateTime?
  resultEmailSentBy String?
  issuedAt  DateTime @default(now())

  centre      Centre       @relation(fields: [centreId], references: [id])
  rider       Rider        @relation(fields: [riderId], references: [id])
  exam        Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([examId])
  @@index([centreId, revokedAt])
  @@index([batchTag])
  // Student/parent portals + monthly-report sweep fetch a rider's latest
  // certificate (where riderId, order by issuedAt) — no riderId index existed.
  @@index([riderId, issuedAt])
}

// ──────────────────────────────────────────────────────────────────────────
// EXAMS — promotion exam scheduling + scoring (ported from exam module)
// Distinct from Assessment (which models broad theory/practical sittings);
// Exam is the formal level-promotion test driven by a ScoringTemplate.
// ──────────────────────────────────────────────────────────────────────────

// HQ-curated catalog of exam levels. SUPER_ADMIN owns this — one row per
// (discipline, order), so the list of levels stays clean and consistent
// across every centre. Centre-specific rubric overrides live on
// ScoringTemplate; without an override, ScoringTemplate falls back to
// ExamLevel.defaultRubricJson.
model ExamLevel {
  id              String   @id @default(cuid())
  // Discipline track this level belongs to (general / dressage / jumping /
  // eventing / gymkhana / endurance / vaulting / polo). Matches the
  // disciplines used in lib/discipline.ts.
  discipline      String   @default("general")
  // Sort order within a discipline. 1 = entry level, increases with
  // difficulty.
  orderIndex      Int
  // Short identifier shown in lists (e.g. "1", "Stage 2", "D", "Adv-I").
  code            String
  // Long human-friendly name shown on certificates ("Beginner",
  // "Foundation", "Preliminary").
  name            String
  // Percentage pass threshold for this level. Cascaded into
  // ScoringTemplate at create time but each centre can override.
  passThreshold   Int      @default(70)
  // Default rubric (JSON of ScoringCategory[]). Centres can override per
  // centre via a custom ScoringTemplate row.
  defaultRubricJson Json?
  // Minimum examiner authority — only EXAMINER rows whose
  // ExaminerAuthority covers this level can lead an exam at this level.
  // Soft hint for now; not strictly enforced.
  minExaminerLevel  Int?
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  templates ScoringTemplate[]

  @@unique([discipline, orderIndex])
  @@unique([discipline, code])
  @@index([discipline, active])
}

model ScoringTemplate {
  id            String   @id @default(cuid())
  centreId      String
  // Soft link to the canonical level row. Optional so legacy templates
  // created before the catalog existed keep working.
  examLevelId   String?
  levelKey      String   // "1" | "2" | "3" | "4" — matches Exam.level
  levelName     String   // "Level 1 — Beginner", etc.
  passThreshold Int      @default(70) // percentage to pass
  categoriesJson Json  // serialized ScoringCategory[]
  updatedAt     DateTime @updatedAt
  updatedBy     String?

  centre    Centre     @relation(fields: [centreId], references: [id], onDelete: Cascade)
  examLevel ExamLevel? @relation(fields: [examLevelId], references: [id], onDelete: SetNull)

  @@unique([centreId, levelKey])
  @@index([examLevelId])
}

model Exam {
  id            String   @id @default(cuid())
  centreId      String
  riderId       String
  // Assigned examiner. NULL = unassigned: scheduled from a sitting pool and not
  // yet claimed. An examiner claims a rider from the pool (first-come), which
  // sets these and locks scoring to them. Single-exam scheduling sets it up front.
  examinerId    String?  // FK to User
  examinerName  String?  // denormalised so historical exams survive renames
  level         Int      // 1..N, matches ScoringTemplate.levelKey
  date          DateTime // exam day (date-only, stored as UTC midnight)
  time          String   @default("09:00") // HH:MM 24h
  status        String   @default("scheduled") // scheduled | in_progress | completed
  // Numeric total. When the exam has co-judges, this is the average of each
  // judge's numericSum() over the rubric (so a single field still drives
  // rider-facing UI, certificates, parent SMS, etc.).
  totalScore    Float?
  // Legacy single-judge score map. Co-judge data lives on ExamJudge.scoresJson.
  scoresJson    Json?
  // Frozen copy of the centre's ScoringTemplate.categoriesJson at the moment
  // the exam was created. Read-only after that — historical exams render
  // their breakdown against THIS, not the live ScoringTemplate, so admins
  // can edit the canonical rubric without retroactively garbling old results.
  // Null on legacy rows that pre-date this column; loadRiderExamHistory +
  // the result-sheet PDF fall back to the live template when null.
  rubricSnapshotJson Json?
  passed        Boolean?
  // Deductions are subtracted from the rubric total before pass/fail. Used
  // for course faults, time penalties, refusals, etc. that aren't rubric
  // items per se.
  deductions    Float    @default(0)
  timeFaults    Float    @default(0)
  // PRD "Test-day support" — grooms / helpers assigned to this exam.
  // JSON array of user.id strings; never deep enough to warrant its own table.
  supportStaffJson Json?
  // Re-attempt link — points to the previous failed exam at this level for
  // the same rider. Lets the result card show "Attempt 2".
  previousExamId  String?
  attemptNumber   Int     @default(1)
  // Sitting groups multiple exams happening on the same day with the same
  // examiner / level (saves typing each one in).
  sittingId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  centre       Centre        @relation(fields: [centreId], references: [id], onDelete: Cascade)
  rider        Rider         @relation(fields: [riderId], references: [id], onDelete: Cascade)
  certificates Certificate[]
  judges       ExamJudge[]
  attachments  ExamAttachment[]
  previousExam Exam?         @relation("ExamReattempt", fields: [previousExamId], references: [id], onDelete: SetNull)
  retakes      Exam[]        @relation("ExamReattempt")
  sitting      ExamSitting?  @relation(fields: [sittingId], references: [id], onDelete: SetNull)

  @@index([centreId, status])
  @@index([examinerId])
  @@index([riderId])
  @@index([sittingId])
}

// One row per judge scoring a single exam. The lead judge (Exam.examinerId)
// is mirrored here as the row with `position = 1` — keeps the math uniform
// when the exam has only one judge.
model ExamJudge {
  id          String   @id @default(cuid())
  examId      String
  judgeId     String   // FK to User
  judgeName   String   // denormalised
  position    Int      @default(1) // 1 = lead, 2 = co-judge, …
  // Per-judge score map and computed numeric total. Null until the judge
  // submits their card.
  scoresJson  Json?
  subTotal    Float?
  submittedAt DateTime?

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, judgeId])
  @@unique([examId, position])
  @@index([judgeId])
}

// File attachments per exam — video clips, evidence photos, scanned judge
// sheets (sealed envelopes from offline / remote exams).
model ExamAttachment {
  id         String   @id @default(cuid())
  examId     String
  kind       String   // video | photo | sheet | other
  url        String
  caption    String?
  uploadedBy String?
  uploadedAt DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

// A scheduled sitting — multiple riders take the same level on the same day
// with the same examiner. Lets us schedule "Saturday's Level 2" in one shot
// instead of 12 individual rows.
model ExamSitting {
  id           String   @id @default(cuid())
  centreId     String
  level        Int
  date         DateTime
  // Legacy single-examiner columns (kept nullable for old rows). The examiner
  // POOL now lives in ExamSittingExaminer — any pooled examiner can claim a
  // rider from the sitting.
  examinerId   String?
  examinerName String?
  notes        String?
  createdAt    DateTime @default(now())

  centre    Centre                @relation(fields: [centreId], references: [id], onDelete: Cascade)
  exams     Exam[]
  examiners ExamSittingExaminer[]

  @@index([centreId, date])
}

// The pool of examiners staffed on a sitting. Any of them can claim (pick) an
// unassigned rider from the sitting to mark it.
model ExamSittingExaminer {
  id           String @id @default(cuid())
  sittingId    String
  examinerId   String // FK to User
  examinerName String // denormalised

  sitting ExamSitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)

  @@unique([sittingId, examinerId])
  @@index([examinerId])
}

// ──────────────────────────────────────────────────────────────────────────
// TEAMS / SQUADS (PRD — "overall team performance")
// ──────────────────────────────────────────────────────────────────────────
// A named group of riders the centre fields together — e.g. "Senior Show
// Jumping Squad 2026". Riders can be on multiple teams (junior + senior).
model Team {
  id        String   @id @default(cuid())
  centreId  String
  name      String
  season    String?  // free text — "2026", "Spring 2026", etc.
  discipline String?
  captainId String?  // rider.id
  active    Boolean  @default(true)
  deletedAt DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          TeamMember[]

  @@index([centreId, active])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  riderId  String
  position String?  // free text — "Captain", "Reserve", or domain-specific
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, riderId])
  @@index([riderId])
}

// ──────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS (§4.22)
// In-app feed today; SMS/WhatsApp/Email dispatch is a future provider wire-up.
// One row per (recipient, event). Multi-recipient broadcasts insert N rows.
// ──────────────────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String    // recipient
  centreId  String?   // for cross-centre filtering on HQ dashboards
  type      String    // "rider.onboarded" | "exam.passed" | "exam.failed" | "medicine.withdrawal" | "task.assigned" | ...
  title     String
  body      String
  link      String?   // optional in-app URL the click takes you to
  channel   String    @default("in_app") // in_app | sms | email | whatsapp
  payload   String?   // serialised metadata (JSON)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([centreId, createdAt])
}

// ──────────────────────────────────────────────────────────────────────────
// AUDIT (§4.23)
// ──────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  tableName String
  rowId     String
  before    String?
  after     String?
  ip        String?
  userAgent String?
  at        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([tableName, rowId])
  @@index([at])
}

// ──────────────────────────────────────────────────────────────────────────
// STAFF ATTENDANCE (PRD §4 Module 2)
// One row per (staff user, day). Day boundary matches the date passed by the
// marker — keep it date-only to dedup correctly across timezones.
// ──────────────────────────────────────────────────────────────────────────

model StaffAttendance {
  id            String    @id @default(cuid())
  userId        String
  centreId      String
  date          DateTime
  status        String    // present | absent | late | leave
  checkInAt     DateTime?
  checkOutAt    DateTime?
  overtimeHours Float?
  notes         String?
  markedBy      String?   // user.id who marked it; plain string (no FK)
  markedAt      DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  centre Centre @relation(fields: [centreId], references: [id])

  @@unique([userId, date])
  @@index([centreId, date])
}

// ──────────────────────────────────────────────────────────────────────────
// PARENT ↔ RIDER LINKAGE (PRD §3, Phase 2 — parent portal)
// Many-to-many. relationship is a free-text label (father | mother | guardian)
// — keeps onboarding from getting stuck on edge cases (legal guardians, etc.).
// ──────────────────────────────────────────────────────────────────────────

model ParentLink {
  id           String   @id @default(cuid())
  parentUserId String
  riderId      String
  relationship String   // father | mother | guardian
  createdAt    DateTime @default(now())

  parent User  @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  rider  Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, riderId])
  @@index([parentUserId])
  @@index([riderId])
}

// ──────────────────────────────────────────────────────────────────────────
// LEAVE REQUESTS (PRD §4 Module 2)
// Staff submit; manager/head-coach approves. status = pending|approved|
// rejected|cancelled. reviewedBy is a plain string so we don't need a second
// User back-relation just for reviewers.
// ──────────────────────────────────────────────────────────────────────────

model LeaveRequest {
  id          String    @id @default(cuid())
  userId      String
  centreId    String
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String    @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  centre Centre @relation(fields: [centreId], references: [id])

  @@index([userId, status])
  @@index([centreId, status])
}

// ──────────────────────────────────────────────────────────────────────────
// EQUIPMENT (HQ catalog + per-centre inventory)
// ──────────────────────────────────────────────────────────────────────────
//
// Two-tier model:
//   • EquipmentCatalog — single platform-wide list of every standard item
//     an equestrian club needs. HQ (SUPER_ADMIN) curates this.
//   • EquipmentStock   — per (centre, catalog item) qty + threshold. Each
//     centre manages its own stock; HQ sees the aggregated matrix.
//
// Threshold logic: stock falls below max(stock.threshold, catalog.defaultThreshold)
// → one notification to the centre's INVENTORY_MANAGER and to every
// SUPER_ADMIN. Dedup is by lastLowNotifiedAt vs. lastRestockedAt.

model EquipmentCatalog {
  id              String  @id @default(cuid())
  category        String  // saddlery | bridlery | protection | rider | stable | grooming | feed | tackroom | arena | vet
  name            String
  // Shorter token used as a column header on HQ matrix views.
  code            String  @unique
  unit            String  @default("piece") // piece | pair | set | metre | kg | litre
  defaultThreshold Int    @default(5) // reorder point applied when no per-centre override
  notes           String?
  active          Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stocks EquipmentStock[]

  @@index([category, active])
}

model EquipmentStock {
  id          String   @id @default(cuid())
  centreId    String
  catalogId   String
  // Legacy single-qty column kept for historical reads + bulk-stock
  // queries. The four condition-state columns below are the new source
  // of truth; qty stays in sync via API writes (qty = unused + inUse).
  // Low-stock alerts compare (qtyUnused + qtyInUse) to threshold so
  // damaged + for-repair items aren't double-counted as "in stock".
  qty         Int      @default(0)
  qtyUnused   Int      @default(0)
  qtyInUse    Int      @default(0)
  qtyForRepair Int     @default(0)
  qtyDamaged  Int      @default(0)
  // "New Required" — qty admin still needs to buy. Drives the
  // procurement queue alongside requisitions.
  newRequired Int      @default(0)
  // Free-text owner label. Used by Sports Equipment to mark whether a
  // mallet/lance belongs to the club or a specific rider. Other
  // categories typically leave this null.
  owner       String?
  // Per-centre override of the catalog default. Null → use catalog.
  threshold   Int?
  notes       String?
  // Used by the low-stock sweep to dedup notifications. If a centre keeps
  // ordering 2 of an item that needs 5, we don't want a notify every day.
  // A restock (qty increase) resets lastLowNotifiedAt so the next time we
  // dip below threshold, the sweep fires again.
  lastLowNotifiedAt DateTime?
  lastRestockedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  centre  Centre           @relation(fields: [centreId], references: [id], onDelete: Cascade)
  catalog EquipmentCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  movements EquipmentStockMovement[]

  @@unique([centreId, catalogId])
  @@index([centreId])
}

// Per-stock audit trail: who changed qty, by how much, and why. Lets HQ
// reconstruct shrinkage or theft questions later.
model EquipmentStockMovement {
  id        String   @id @default(cuid())
  stockId   String
  delta     Int      // positive = restock, negative = consumption/loss
  reason    String   // restock | consumed | lost | damaged | adjustment | initial
  notes     String?
  actorId   String?
  at        DateTime @default(now())

  stock EquipmentStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, at])
}

// ──────────────────────────────────────────────────────────────────────────
// EVENTS (clinics, schooling, demos, parent days, fundraisers, externals)
// ──────────────────────────────────────────────────────────────────────────
//
// Distinct from `Competition` (which carries classes / draw / prizes /
// scoreboard). Events are simpler logistical gatherings — a clinic, a
// schooling day, a fundraiser. Some events live entirely at one centre;
// "external" events are off-site (members travelling to another club).

model Event {
  id          String   @id @default(cuid())
  centreId    String   // host centre, even for externals (the centre running the trip)
  title       String
  type        String   // clinic | schooling | demo | parent_day | fundraiser | external_show | camp | open_house | other
  description String?
  // External-event metadata. Null for in-house events.
  externalVenue   String?
  externalHostOrg String?
  startDate   DateTime
  endDate     DateTime
  // Optional registration fee per rider; 0 means free attendance.
  fee         Float    @default(0)
  // Soft capacity. Null = unlimited. Hit-cap is a UI hint, not enforced
  // server-side (waitlists belong to a future iteration).
  capacity    Int?
  // Visibility — published events show on the public /events/<slug>/page;
  // private events are admin-only.
  isPublic    Boolean  @default(false)
  slug        String?  @unique
  status      String   @default("draft") // draft | open | live | completed | cancelled
  contactName String?
  contactPhone String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  centre        Centre              @relation(fields: [centreId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([centreId, status])
  @@index([startDate])
}

model EventRegistration {
  id          String   @id @default(cuid())
  eventId     String
  riderId     String
  status      String   @default("registered") // registered | attended | no_show | cancelled
  paid        Boolean  @default(false)
  // Optional notes from the registration form (dietary, room sharing, …).
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([eventId, riderId])
  @@index([eventId, status])
}

// ──────────────────────────────────────────────────────────────────────────
// FINANCE — expenses + vendors (income side is Invoice/Payment already)
// ──────────────────────────────────────────────────────────────────────────
//
// Centres book operating expenses against categories (feed, vet, salaries,
// fuel, …). Each expense optionally points at a Vendor for accounts-payable
// reporting. The P&L cards on /finance subtract these from invoice
// payments to give net income.

model ExpenseCategory {
  id        String   @id @default(cuid())
  // Curated by SUPER_ADMIN. Categories are platform-wide (every centre
  // books against the same chart of accounts so HQ rollups are sensible).
  code      String   @unique
  name      String
  group     String   // operating | salaries | vet | feed | maintenance | utilities | tax | other
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  expenses   Expense[]
  hqExpenses HqExpense[] @relation("HqExpenseCategory")
}

model Vendor {
  id        String   @id @default(cuid())
  centreId  String   // the centre that registered the vendor (owner). For
                     // deliveryScope="national" the vendor is still owned here
                     // but visible to every centre in the same org.
  // Delivery coverage: "centre" = local supplier, visible only to its own
  // club; "national" = all-India delivery, visible to every club in the org.
  deliveryScope String @default("centre")
  name      String
  // Category drives the contact-database UX — admins filter by type when
  // looking for "an ambulance" vs "a feed supplier". Free-text-ish but
  // standardised in the UI dropdown (see /vendors page).
  // vet | farrier | horse_ambulance | truck | feed | equipment_gear | other
  category    String   @default("other")
  // Per-category extra info — Vet Doctor: VCI #, qualification, specialty,
  // years practice, on-call flag, clinic affiliation. Farrier: years
  // experience, specialisations, available days, carries-forge, hourly
  // rate. Free-form JSON so adding a new vendor type doesn't require
  // another schema migration. Shape per kind is in lib/schemas/vendor.ts.
  categorySpecificJson Json?
  contactName String?
  phone     String?
  email     String?
  address   String?
  gstin     String?
  // Bank details for payment runs. Optional — most centres pay vendors by
  // UPI/cash for small bills, but recurring contracts (feed suppliers,
  // ambulance retainers) want NEFT/IMPS via these fields. Branch is
  // derivable from IFSC so we skip storing it.
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  // UPI VPA for instant payouts (e.g. vendor@okhdfcbank). Alternative to NEFT.
  upiId             String?
  notes     String?
  active    Boolean  @default(true)
  deletedAt DateTime?  // set on soft-delete; bin purges 30 days later
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centre   Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([centreId, active])
}

// Headquarters-level expenses — the SUPER_ADMIN's view. These are payments
// the centre-level coaches/accountant don't typically handle:
//   - umbrella insurance, corporate software subscriptions, legal/audit fees
//   - bulk purchases that benefit multiple clubs (vaccines bought centrally
//     then distributed)
//   - HQ rent, marketing spend, federation memberships
// Tag rows to one or more centres so HQ rollup reports can allocate cost
// per club; leave taggedCentreIds empty for purely-HQ overheads.
model HqExpense {
  id          String   @id @default(cuid())
  orgId       String
  categoryId  String?  // optional — uses platform ExpenseCategory codes
  amount      Float
  gstAmount   Float    @default(0)
  spentAt     DateTime
  description String
  vendorName  String?  // free-text; no Vendor row (HQ-side vendors aren't
                       // centre-scoped, so the existing Vendor model doesn't fit)
  invoiceRef  String?
  // Comma-separated centre IDs this expense allocates to. Empty/null = pure
  // HQ overhead (not allocated). One value = single-club expense the HQ
  // paid for. Many values = shared across listed clubs.
  taggedCentreIdsCsv String?
  paid        Boolean  @default(false)
  paidAt      DateTime?
  method      String?  // cash | bank | cheque | upi | card
  attachmentUrl String  // required — HQ invoices must have a doc
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation("HqExpenseCategory", fields: [categoryId], references: [id])

  @@index([orgId, spentAt])
}

// Staff entry/exit log — physical premise tracking (think MyGate). One
// row per gate event; multiple rows per staff per day (morning entry,
// lunch out, lunch in, evening exit, etc). The reception/security desk
// records these on the /gate kiosk page; the centre manager reviews
// totals on a dashboard.
//
// Distinct from StaffAttendance which is class-roster attendance (was
// the coach in the arena for the 6am batch?). Gate events answer
// "what time did Ravi come in this morning?"
model StaffGateEvent {
  id              String   @id @default(cuid())
  centreId        String
  staffUserId     String
  direction       String   // "in" | "out"
  occurredAt      DateTime @default(now())
  notes           String?
  // The user who recorded the event — guard / receptionist / manager.
  recordedByUserId String
  createdAt       DateTime @default(now())

  centre Centre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  staff  User   @relation("StaffGateStaff", fields: [staffUserId], references: [id])

  @@index([centreId, occurredAt])
  @@index([staffUserId, occurredAt])
}

// Short-link / deep-link for WhatsApp distribution. Admin generates a
// shareable URL pointing at a pre-scoped form (e.g. "report injury for
// Bijli"). The coach taps it from WhatsApp on their phone and lands on
// the right form with horse/coach context pre-filled — no scrolling, no
// login dance if the link's `requiresAuth` is false (we still rate-limit
// by code).
//
// Code is an 8-char base32 (Crockford) so it's typeable, copy-safe, and
// short enough to fit comfortably in a WhatsApp message.
model ShortLink {
  id              String   @id @default(cuid())
  code            String   @unique
  // Centre-scoped — admins can only generate links for their own centre.
  centreId        String
  // Categorises the link. Used for analytics + to map to a form template.
  // Values: injury | rider_onboard | expense_submit | requisition | vet_visit | generic
  kind            String
  // Where to send the user after redemption. Path-only (no host) so we can
  // safely build the redirect URL from the request origin.
  targetPath      String
  // JSON map of query-string params to merge into the redirect (e.g.
  // {"horseId":"abc","coachId":"def"}). Pre-fills the destination form.
  paramsJson      Json?
  // Display label shown on the redemption interstitial — "Report injury for Bijli".
  label           String?
  // null = never expires; we still enforce a soft cap of 90 days at create-time.
  expiresAt       DateTime?
  // singleUse links self-expire on first redeem so a shared WhatsApp link
  // can't be forwarded onward.
  singleUse       Boolean  @default(false)
  redeemCount     Int      @default(0)
  lastRedeemedAt  DateTime?
  createdByUserId String
  createdAt       DateTime @default(now())

  centre Centre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@index([centreId, createdAt])
}

// Procurement requisition. Staff submits a request to purchase feed,
// medicine, equipment, or services; a centre-side approver (manager) signs
// off first; an accountant signs off second. Once `approved` reaches stage
// "approved", the buyer (typically the requester, or stable manager) goes
// ahead and procures; the resulting invoice gets uploaded via the
// /expenses/submit flow.
//
// Items are stored as JSON rather than a child table to keep the model
// simple — a requisition is usually 1-5 line items, never bulk catalog data.
model Requisition {
  id                  String   @id @default(cuid())
  centreId            String
  requestedByUserId   String
  // JSON: [{ name, qty, unit, estimatedUnitCost, notes? }]
  itemsJson           Json
  totalEstimatedCost  Float
  reason              String?  // why this is needed
  // Two-stage workflow. pending_manager → pending_accountant → approved.
  // rejected can happen at either stage; rejectedReason captures the why.
  stage               String   @default("pending_manager")
  managerDecidedByUserId    String?
  managerDecidedAt          DateTime?
  managerNotes              String?
  accountantDecidedByUserId String?
  accountantDecidedAt       DateTime?
  accountantNotes           String?
  rejectedReason     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  centre        Centre @relation(fields: [centreId], references: [id])
  requestedBy   User   @relation(fields: [requestedByUserId], references: [id])

  @@index([centreId, stage])
  @@index([requestedByUserId])
}

model Expense {
  id          String   @id @default(cuid())
  centreId    String
  categoryId  String
  vendorId    String?
  amount      Float
  gstAmount   Float    @default(0)
  // Optional quantity + per-unit rate for procurement that's bought by
  // measure (fodder/hay by kg/bale, etc.). `amount` stays the authoritative
  // total (qty × unitRate when both set). Null for lump-sum expenses.
  qty         Float?
  unitRate    Float?
  // Date of the expense as it actually occurred (vs createdAt = when it
  // was booked into the system). Used for P&L window queries.
  spentAt     DateTime
  description String
  invoiceRef  String?  // vendor invoice number / receipt ref
  paid        Boolean  @default(false)
  paidAt      DateTime?
  method      String?  // cash | bank | cheque | upi | card
  attachmentUrl String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  centre   Centre          @relation(fields: [centreId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  vendor   Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([centreId, spentAt])
  @@index([categoryId])
}

// ──────────────────────────────────────────────────────────────────────────
// ACCREDITATIONS (external federation credentials per rider)
// ──────────────────────────────────────────────────────────────────────────
//
// Distinct from in-house Certificate (which we issue). Accreditations are
// records of credentials held by a rider from external bodies — BHS, EFI,
// state federations, coaching diplomas. Useful for HQ to track team
// eligibility (only nationally-licensed riders can enter a National Show).

model Accreditation {
  id          String   @id @default(cuid())
  riderId     String
  // Body issuing the credential (e.g. "EFI", "BHS", "FEI", state federation).
  body        String
  // What kind of credential. Free-text by design — federations vary widely.
  title       String   // "EFI Junior Membership" | "BHS Stage 2" | "FEI Pony Rider Eligibility"
  discipline  String?  // optional — dressage / jumping / eventing / general
  level       String?  // optional — "Stage 2", "Cat-B", etc.
  serialNo    String?
  // When the credential was issued and when it expires (some federation
  // memberships renew annually).
  issuedAt    DateTime
  expiresAt   DateTime?
  fileUrl     String?  // scan of the original card/cert
  // Operational status — verified by a centre manager after seeing the
  // physical card; revoked if the body cancels it.
  status      String   @default("active") // active | expired | revoked
  verifiedBy  String?  // userId who confirmed it
  verifiedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, status])
  @@index([body, level])
}

// ──────────────────────────────────────────────────────────────────────────
// SPRINT 5 — payroll deduction, daily coach updates, venue transport
// inventory, manual inspection/audit runs.
// ──────────────────────────────────────────────────────────────────────────

// A single month's salary settlement for a staff member. When recorded, any
// outstanding EmployeeAdvance balances are netted off (advanceDeducted) and
// AdvanceRepayment rows are written, so "advance debited from salary" is one
// action. net = gross - advanceDeducted - otherDeductions.
model SalaryPayment {
  id               String   @id @default(cuid())
  centreId         String
  userId           String
  periodMonth      String   // "2026-05"
  grossAmount      Float
  advanceDeducted  Float    @default(0)
  otherDeductions  Float    @default(0)
  // Attendance-driven deduction for the month: absentDays etc × the global
  // per-status rate (PayrollConfig). deductionBreakdownJson keeps the
  // per-status counts + amounts so the payslip is fully explainable.
  attendanceDeducted     Float   @default(0)
  absentDays             Int     @default(0)
  deductionBreakdownJson Json?
  netAmount        Float
  method           String?  // cash | bank | upi | cheque
  paidAt           DateTime?
  notes            String?
  recordedByUserId String
  createdAt        DateTime @default(now())

  centre Centre @relation(fields: [centreId], references: [id])
  user   User   @relation("SalaryPaymentUser", fields: [userId], references: [id])

  @@unique([userId, periodMonth])
  @@index([centreId, periodMonth])
}

// Effective-dated salary history per staff member. A raise is a new row with
// a later effectiveFrom; the salary for any month = the row with the latest
// effectiveFrom on or before that month. Editable by SUPER_ADMIN / ADMIN /
// ACCOUNTANT.
model SalaryStructure {
  id              String   @id @default(cuid())
  userId          String
  centreId        String
  monthlySalary   Float
  effectiveFrom   DateTime // date-only (UTC noon)
  note            String?  // "Annual increment", "Promotion to Head Coach", etc.
  createdByUserId String
  createdAt       DateTime @default(now())

  user   User   @relation("SalaryStructureUser", fields: [userId], references: [id], onDelete: Cascade)
  centre Centre @relation(fields: [centreId], references: [id])

  @@index([userId, effectiveFrom])
  @@index([centreId])
}

// Global (org-wide) payroll configuration — the single place Super Admin sets
// how much is deducted per day for each staff-attendance status.
// deductionRulesJson is a dynamic map { status: amountPerDay }, e.g.
// { "absent": 500, "late": 100, "leave": 0, "half_day": 250 }. JSON map so new
// statuses can be added without a migration.
model PayrollConfig {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  deductionRulesJson Json   @default("{}")
  updatedByUserId    String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Coach's "daily 5-minute update" — a fast end-of-day log distinct from the
// per-horse checklist. Captures what was covered, how many horses worked,
// and any injuries/concerns to escalate. One per coach per day per centre.
model CoachDailyUpdate {
  id            String   @id @default(cuid())
  centreId      String
  coachUserId   String
  date          DateTime // date-only (UTC noon)
  summary       String
  horsesWorked  Int?
  ridersTaught  Int?
  injuriesNoted String?
  minutesSpent  Int?
  createdAt     DateTime @default(now())

  centre Centre @relation(fields: [centreId], references: [id])
  coach  User   @relation("CoachDailyUpdateCoach", fields: [coachUserId], references: [id])

  @@unique([centreId, coachUserId, date])
  @@index([centreId, date])
}

// A trip taking horses + equipment to an event venue. The inventory is
// checked OUT before departure and IN on return, so anything lost/damaged at
// the venue is caught immediately. status: planned → departed → returned.
model VenueTrip {
  id             String   @id @default(cuid())
  centreId       String
  eventName      String
  venue          String
  departureAt    DateTime
  returnAt       DateTime?
  status         String   @default("planned") // planned | departed | returned | cancelled
  notes          String?
  createdByUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  centre Centre @relation(fields: [centreId], references: [id])
  items  TripChecklistItem[]

  @@index([centreId, departureAt])
  @@index([status])
}

model TripChecklistItem {
  id           String   @id @default(cuid())
  tripId       String
  category     String   // horse | tack | feed | equipment | medical | document | other
  label        String
  qtyExpected  Int      @default(1)
  // Out = loaded before departure; In = verified back at the club.
  checkedOut   Boolean  @default(false)
  checkedOutAt DateTime?
  conditionOut String?  // ok | damaged | note text
  checkedIn    Boolean  @default(false)
  checkedInAt  DateTime?
  conditionIn  String?  // ok | damaged | missing | note text
  remarks      String?

  trip VenueTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// Manual inspection / audit run performed by an INSPECTION_OFFICER (external
// auditor) or admin. Scoped to one centre; each line item is marked
// pass/fail/na with remarks. Mirrors the paper SOP audit sheet.
model AuditRun {
  id              String   @id @default(cuid())
  centreId        String
  inspectorUserId String
  scope           String   // inventory | vet_inventory | stable | full
  status          String   @default("in_progress") // in_progress | completed
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  summary         String?

  centre    Centre     @relation(fields: [centreId], references: [id])
  inspector User       @relation("AuditRunInspector", fields: [inspectorUserId], references: [id])
  items     AuditItem[]

  @@index([centreId, startedAt])
  @@index([status])
}

model AuditItem {
  id       String  @id @default(cuid())
  runId    String
  area     String  // e.g. "Tack room", "Vet cabinet", "Feed store"
  label    String
  result   String  @default("pending") // pass | fail | na | pending
  remarks  String?

  run AuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// Notification dispatch log — every failed outbound notification
// (sms / email / whatsapp) writes a row here. Success paths don't;
// audit() in the general log covers them. This table exists so an
// admin can answer "what notifications didn't go out and why?"
// without grepping a generic audit log full of CRUD events.
//
// Retention: hard 90 days. A future sweep can prune older rows; for
// now the table is small enough not to need one.
model NotificationDispatchLog {
  id        String   @id @default(cuid())
  // "failed" (a dispatch error — the original use) or "sent" (a successful
  // delivery, recorded for per-channel idempotency: a send helper skips a
  // (channel, refType, refRowId, recipient) it already delivered within the
  // dedupe window, so a crash-rerun can't re-send one channel while dropping
  // another — H5). Existing rows default to "failed".
  status    String   @default("failed")
  channel   String   // "sms" | "email" | "whatsapp"
  // Error code from the dispatcher (lib/sms.ts etc.) — e.g. "TWILIO_429",
  // "META_400", "NETWORK", "INVALID_PHONE", "INVALID_ADDRESS". Empty for "sent".
  error     String
  // E.164 phone or email address. Useful for "did this user's number
  // bounce twice in a row?" — but PII; restrict the read surface.
  recipient String
  // Cross-ref to the audit row that triggered the send — e.g.
  // "invoice.due_soon" + the invoice id. Lets you drill from "this
  // notification failed" → "what was the upstream event".
  refType   String?
  refRowId  String?
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
  @@index([createdAt])
  // The per-channel dedupe lookup (recentlySent): exact key + recency.
  @@index([channel, refType, refRowId, status, createdAt])
}

// Single-flight lock for the nightly sweep batch (H5). One row (id="sweep").
// The cron route claims it before runAllSweeps and releases it after, so an
// overlapping run (manual POST during the scheduled run, or a Vercel retry of a
// partially-completed batch) is skipped rather than re-firing every job. A
// stale lock (holder crashed) auto-expires after the cron route's stale window,
// so a crash can't wedge the batch permanently.
model CronLock {
  id        String    @id
  lockedAt  DateTime?
  updatedAt DateTime  @updatedAt
}

// Rider-initiated request to move to a different batch — either for a
// single day (e.g. "I can't make Wednesday, can I attend Thursday's
// batch this week?") or permanently (e.g. "I'm switching schools, my
// new schedule means I need the morning slot from now on").
//
// Approval routing:
//   - Single-day: any coach assigned to the target batch can approve.
//   - Permanent: centre manager approves (riders' batch assignments
//     are a roster decision, not a per-coach one).
//
// On approve, single-day creates an Attendance row in the target batch
// for the date; permanent updates rider.batchId. Reject leaves no
// side-effect beyond the audit + a denial notification to the rider.
model BatchShiftRequest {
  id           String   @id @default(cuid())
  riderId      String
  // 'single_day' OR 'permanent' — drives the approver gate + the side-
  // effect on approval (see notes above).
  kind         String
  // The batch the rider currently belongs to (snapshot at request time
  // so a Permanent that gets approved months later still records the
  // original batch even if rider.batchId has since moved).
  fromBatchId  String?
  // The batch the rider wants to move into.
  toBatchId    String
  // For single_day: the specific date the rider wants to attend the
  // target batch. Null for permanent (no date applies; the change
  // takes effect from approval onward).
  shiftDate    DateTime?
  // For permanent shifts: the date from which the new batch becomes
  // active. Defaults to approval timestamp if omitted by rider.
  effectiveFrom DateTime?
  reason       String?  // why the rider wants to shift; visible to approver
  status       String   @default("pending") // pending | approved | rejected | cancelled
  decidedByUserId String?
  decidedAt    DateTime?
  decisionNote String?  // approver's note on accept/reject (visible to rider)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rider     Rider  @relation(fields: [riderId], references: [id], onDelete: Cascade)
  fromBatch Batch? @relation("BatchShiftFrom", fields: [fromBatchId], references: [id])
  toBatch   Batch  @relation("BatchShiftTo",   fields: [toBatchId],   references: [id])
  decidedBy User?  @relation("BatchShiftDecidedBy", fields: [decidedByUserId], references: [id])

  @@index([riderId, status])
  @@index([toBatchId, status])
  @@index([status, createdAt])
}
