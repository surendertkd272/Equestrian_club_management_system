# ────────────────────────────────────────────────────────────────────────────
# Equiwings — environment variables
#
# Order:
#   REQUIRED IN ALL ENVS     · the app refuses to start without these
#   REQUIRED IN PROD ONLY    · dev defaults to dry-run / mock
#   OPTIONAL                 · feature toggles + tuning knobs
#
# Validation: `npm run preflight` checks every required var below for the
# given NODE_ENV before you deploy. Fails loud if anything is missing.
# ────────────────────────────────────────────────────────────────────────────

# ─── REQUIRED IN ALL ENVS ───────────────────────────────────────────────────

# Database. For dev → SQLite (`file:./dev.db`). For prod → Postgres with a
# pooler URL (Neon's pooled connection, Supabase pgbouncer, RDS Proxy).
# Example: postgresql://user:pass@ep-foo-bar.ap-south-1.neon.tech:5432/equiwings?pgbouncer=true&connection_limit=1
DATABASE_URL="file:./dev.db"

# Direct (non-pooled) connection. Prisma uses this for migrations + introspection
# because pgbouncer doesn't support all the queries Prisma's migration engine
# runs. Same Postgres instance, port 5432 direct (no pgbouncer).
# Example: postgresql://user:pass@ep-foo-bar.ap-south-1.neon.tech:5432/equiwings
DIRECT_URL=""

# JWT secrets — separate for tenant + owner cookies so a leak of one
# doesn't compromise the other. Generate each with:
#   openssl rand -base64 48
JWT_SECRET="dev-only-replace-with-openssl-rand-base64-48"
OWNER_JWT_SECRET="dev-only-replace-with-openssl-rand-base64-48"
JWT_ACCESS_TTL_MIN=60

# Public origin of the app. Used in email links, OAuth redirects, Razorpay
# return URLs. Production: https://app.equiwings.example
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma- or whitespace-separated list of hostnames that are "us" (not a
# tenant custom domain). Defaults to NEXT_PUBLIC_APP_URL's host if unset.
# Example: "app.equiwings.in, www.equiwings.in"
APP_HOSTS=""

# ─── REQUIRED IN PROD ONLY (dev runs in dry-run when blank) ─────────────────

# Cron sweeps — shared secret for /api/cron/sweep. Vercel Cron, GitHub
# Actions, or cron-job.org passes this in Authorization: Bearer or ?secret=
# Generate: openssl rand -hex 32
CRON_SECRET=""

# Email — SendGrid (or any provider supporting the SMTP/HTTPS API).
# SENDGRID_FROM_EMAIL must be a verified sender. DKIM + SPF MUST be set in
# DNS — see DEPLOYMENT.md.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME="Equiwings"

# SMS — Twilio. India requires DLT-registered senders for transactional
# SMS; set the headers Twilio expects via console, no env var needed for
# the registration itself but the FROM must match the registered sender id.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# WhatsApp Business API — direct Meta Cloud API integration.
# Templates must be pre-approved in Meta Business Manager; see DEPLOYMENT.md
# for the list of templates this app sends (ew_invoice_due_soon,
# ew_absence_streak, ew_payment_received, etc.).
#
# WHATSAPP_PHONE_NUMBER_ID + WHATSAPP_ACCESS_TOKEN are the two required ids.
# WHATSAPP_API_BASE defaults to https://graph.facebook.com/v18.0 — only set
# if you're going through a BSP that proxies Meta (360Dialog etc.).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_BASE=""

# ─── BILLING (one of Stripe or Razorpay required for paid launch) ───────────

# Razorpay — preferred for INR. Needed for both per-rider invoices and
# the SaaS subscription itself. Set all 4 to enable:
#   1. NEXT_PUBLIC_RAZORPAY_KEY_ID === RAZORPAY_KEY_ID (it's exposed to the browser)
#   2. WEBHOOK_SECRET from Razorpay dashboard → Webhooks
#      Point the endpoint at https://YOUR_HOST/api/webhooks/razorpay
#      Subscribe to: payment.captured, subscription.charged, subscription.halted,
#                    subscription.cancelled, subscription.completed,
#                    subscription.authenticated, subscription.activated
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Razorpay Subscription plan ids — one per tier. Create the plans in the
# Razorpay dashboard at the prices you actually charge (₹/month), then
# paste the plan ids here. Without these, the "Create subscription"
# button in the owner portal returns PLAN_ID_NOT_CONFIGURED.
RAZORPAY_PLAN_STARTER=""
RAZORPAY_PLAN_PRO=""
RAZORPAY_PLAN_ENTERPRISE=""

# Stripe — for international cards. Optional but recommended.
#   1. STRIPE_SECRET_KEY: sk_test_… or sk_live_…
#   2. STRIPE_WEBHOOK_SECRET: whsec_… (Dashboard → Developers → Webhooks)
#      Point at https://YOUR_HOST/api/webhooks/stripe; subscribe to:
#        customer.subscription.created, .updated, .deleted,
#        invoice.payment_failed, invoice.payment_succeeded
#   3. STRIPE_BILLING_PORTAL_RETURN_URL: where Stripe redirects when the
#      user clicks "Return" in the portal.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_BILLING_PORTAL_RETURN_URL=""

# ─── FILE STORAGE ───────────────────────────────────────────────────────────

# S3 / R2 / Spaces / MinIO — leave blank in dev to write to public/uploads.
# In prod, set all four to enable S3-style uploads:
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET=""
S3_PUBLIC_URL=""          # e.g. https://uploads.equiwings.in or https://r2-bucket.cloudflarestorage.com
S3_REGION="ap-south-1"
S3_ENDPOINT=""            # only for non-AWS providers (R2/Spaces/MinIO)

# ─── OBSERVABILITY (optional but recommended) ───────────────────────────────

# Sentry — application error monitoring.
# Initialised via lib/sentry.ts; needs `npm install @sentry/nextjs` to fully wire up.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"

# App version stamp (good for log/sentry correlation).
# Vercel sets this automatically via VERCEL_GIT_COMMIT_SHA; copy it here.
APP_VERSION=""

# Structured log level. info | warn | error | debug.
LOG_LEVEL="info"

# ─── TUNING KNOBS ───────────────────────────────────────────────────────────

# Notification SSE — DB poll cadence + per-user connection cap + max
# lifetime per SSE connection (forces a reconnect to dodge proxies that
# cut idle connections at 60s). Vercel Hobby caps at 60s, so default to
# 55000ms; on Enterprise / self-host you can raise to 5+ minutes.
NOTIF_SSE_POLL_MS="10000"
NOTIF_SSE_MAX_PER_USER="5"
NOTIF_SSE_MAX_LIFETIME_MS="55000"

# UAT / demo dropdown that lets you switch between seeded test users on
# the login page. NEVER set in production — it both reveals user list
# and bypasses login rate-limiting (the dropdown's auto-login flow is
# tagged as expected traffic).
NEXT_PUBLIC_SHOW_TEST_DROPDOWN=""

# Audit log retention (sweep). 730 = ~2 years; minimum 30, maximum 3650.
AUDIT_RETENTION_DAYS="730"

# Allow non-SQLite DATABASE_URL for the dev-only reset/backfill scripts.
# Production scripts should NEVER set this.
ALLOW_NON_SQLITE=""

# ─── BUILD-TIME (set in your hosting platform's "Environment" UI) ───────────

# NODE_ENV is set automatically by Vercel/Railway/etc — listed here only so
# preflight can warn when it's "production" but billing creds are blank.
# NODE_ENV="production"
