{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "buildCommand": "prisma generate && sh -c 'if [ \"$VERCEL_ENV\" = production ]; then prisma migrate deploy; else echo \"skipping migrate deploy (VERCEL_ENV=$VERCEL_ENV)\"; fi' && next build",
  "crons": [
    {
      "path": "/api/cron/sweep?secret=$CRON_SECRET",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "app/api/cron/sweep/route.ts": {
      "maxDuration": 300
    },
    "app/api/reports/monthly-dispatch/route.ts": {
      "maxDuration": 300
    },
    "app/api/notifications/stream/route.ts": {
      "maxDuration": 60
    }
  }
}
